# github.com/dillacorn/awtarchy/tree/main/local/share/applications
# ~/.local/share/applications/waybar_rotate.desktop

[Desktop Entry]
Type=Application
Name=Quickshell Bar rotate (focused display)
Comment=Rotate Quickshell Bar between horizontal and vertical on the currently focused monitor
Exec=sh -lc 'exec "$HOME/.config/hypr/scripts/quickshell_bar_rotate.sh"'
Icon=object-rotate-right
Terminal=false
Categories=Utility;
