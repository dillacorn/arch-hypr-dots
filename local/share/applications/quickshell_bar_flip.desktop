# github.com/dillacorn/awtarchy/tree/main/local/share/applications
# ~/.local/share/applications/waybar_flip.desktop

[Desktop Entry]
Type=Application
Name=Quickshell Bar flip (focused display)
Comment=Flip Quickshell Bar side on the currently focused monitor
Exec=sh -lc 'exec "$HOME/.config/hypr/scripts/quickshell_bar_flip.sh"'
Icon=view-refresh
Terminal=false
Categories=Utility;

