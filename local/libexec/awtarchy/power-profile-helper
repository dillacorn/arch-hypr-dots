#!/usr/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022

PACMAN="/usr/bin/pacman"
SYSTEMCTL="/usr/bin/systemctl"
TLP="/usr/bin/tlp"
TLP_STAT="/usr/bin/tlp-stat"
CONFIG_DIR="/etc/tlp.d"
USER_CONFIG="/etc/tlp.conf"
MANAGED_CONFIG="${CONFIG_DIR}/00-awtarchy-battery-care.conf"
MANAGED_FILE="/var/lib/awtarchy/managed-packages"

fail() {
  printf 'power-profile-helper: %s\n' "$*" >&2
  exit 2
}

package_installed() {
  "$PACMAN" -Qq 2>/dev/null | /usr/bin/grep -Fx -- "$1" >/dev/null
}

is_laptop() {
  local battery
  for battery in /sys/class/power_supply/BAT*; do
    [[ -e "$battery" ]] && return 0
  done

  case "$(/usr/bin/cat /sys/class/dmi/id/chassis_type 2>/dev/null || true)" in
    8|9|10|14|30|31|32) return 0 ;;
    *) return 1 ;;
  esac
}

record_managed() {
  local package tmp
  (( $# > 0 )) || return 0

  /usr/bin/install -d -m 0755 /var/lib/awtarchy
  tmp="$(/usr/bin/mktemp /var/lib/awtarchy/managed-packages.XXXXXX)"
  if [[ -r "$MANAGED_FILE" ]]; then
    /usr/bin/cat "$MANAGED_FILE" >"$tmp"
  fi
  for package in "$@"; do
    package_installed "$package" && printf '%s\n' "$package" >>"$tmp"
  done
  LC_ALL=C /usr/bin/sort -u -o "$tmp" "$tmp"
  /usr/bin/install -m 0644 -o root -g root "$tmp" "$MANAGED_FILE"
  /usr/bin/rm -f -- "$tmp"
}

forget_managed() {
  local package="$1" tmp
  [[ -r "$MANAGED_FILE" ]] || return 0

  tmp="$(/usr/bin/mktemp /var/lib/awtarchy/managed-packages.XXXXXX)"
  /usr/bin/grep -Fxv -- "$package" "$MANAGED_FILE" >"$tmp" || true
  /usr/bin/install -m 0644 -o root -g root "$tmp" "$MANAGED_FILE"
  /usr/bin/rm -f -- "$tmp"
}

install_tlp_backend() {
  local had_tlp=0 had_tlp_pd=0
  package_installed tlp && had_tlp=1
  package_installed tlp-pd && had_tlp_pd=1

  "$PACMAN" -S --needed --noconfirm tlp tlp-pd
  "$SYSTEMCTL" enable --now tlp.service tlp-pd.service

  if (( had_tlp == 0 && had_tlp_pd == 0 )); then
    record_managed tlp tlp-pd
  elif (( had_tlp == 0 )); then
    record_managed tlp
  elif (( had_tlp_pd == 0 )); then
    record_managed tlp-pd
  fi
}

setup_backend() {
  if package_installed tlp && package_installed power-profiles-daemon; then
    fail 'TLP and power-profiles-daemon are both installed; use resolve-tlp-conflict'
  fi

  if package_installed power-profiles-daemon && ! package_installed tlp; then
    "$SYSTEMCTL" enable --now power-profiles-daemon.service
    return 0
  fi

  install_tlp_backend
}

resolve_tlp_conflict() {
  package_installed tlp \
    || fail 'resolve-tlp-conflict requires TLP to be installed'
  package_installed power-profiles-daemon \
    || fail 'resolve-tlp-conflict requires power-profiles-daemon to be installed'

  "$SYSTEMCTL" disable --now power-profiles-daemon.service 2>/dev/null || true
  "$PACMAN" -Rns --noconfirm power-profiles-daemon
  forget_managed power-profiles-daemon
  install_tlp_backend
}

battery_tlp_report() {
  "$TLP_STAT" -b 2>/dev/null || true
}

battery_parse_field() {
  local report="$1" field="$2"
  /usr/bin/awk -F: -v field="$field" '
    index($0, field ":") == 1 {
      value=$2
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print value
      exit
    }
  ' <<<"$report"
}

battery_parse_spec() {
  local report="$1" prefix="$2"
  /usr/bin/sed -n -E "s/^\\*[[:space:]]+${prefix}_[^:]+:[[:space:]]*(.*)$/\\1/p" \
    <<<"$report" | /usr/bin/head -n1
}

battery_parse_range() {
  local spec="$1" first last min max
  [[ "$spec" == *..* ]] || return 1

  first="${spec%%..*}"
  last="${spec##*..}"
  [[ "$first" =~ ([0-9]+) ]] || return 1
  min="${BASH_REMATCH[1]}"
  [[ "$last" =~ ([0-9]+) ]] || return 1
  max="${BASH_REMATCH[1]}"
  (( min <= max )) || return 1

  printf '%s\t%s\n' "$min" "$max"
}

battery_parse_values() {
  local spec="$1"
  /usr/bin/grep -oE '[0-9]+' <<<"$spec" | /usr/bin/awk '!seen[$0]++ { print $0 }'
}

battery_value_in_list() {
  local expected="$1" value
  shift
  for value in "$@"; do
    [[ "$value" == "$expected" ]] && return 0
  done
  return 1
}

battery_spec_is_percentage_control() {
  local spec="$1" range min max value
  local -a values=()

  if range="$(battery_parse_range "$spec" 2>/dev/null)"; then
    IFS=$'\t' read -r min max <<<"$range"
    (( min >= 0 && max <= 100 && max > 1 && min < 100 ))
    return
  fi

  mapfile -t values < <(battery_parse_values "$spec")
  for value in "${values[@]}"; do
    if (( value >= 2 && value < 100 )); then
      return 0
    fi
  done
  return 1
}

battery_require_capability() {
  local report="$1" features stop_spec
  features="$(battery_parse_field "$report" 'Supported features')"
  features="${features,,}"
  stop_spec="$(battery_parse_spec "$report" STOP_CHARGE_THRESH)"

  [[ "$features" == *"charge threshold"* ]] \
    || fail 'TLP does not report percentage charge-threshold support on this hardware'
  [[ -n "$stop_spec" ]] \
    || fail 'TLP did not report a configurable stop charge threshold'
  battery_spec_is_percentage_control "$stop_spec" \
    || fail 'TLP reports a non-percentage Battery Care mode; configure it with TLPUI'
}

battery_external_config_sources() {
  local file
  shopt -s nullglob
  for file in "$CONFIG_DIR"/*.conf "$USER_CONFIG"; do
    [[ -f "$file" ]] || continue
    [[ "$file" == "$MANAGED_CONFIG" ]] && continue
    if /usr/bin/grep -Eq '^[[:space:]]*(START|STOP)_CHARGE_THRESH_BAT[0-9]+[[:space:]]*=' "$file"; then
      printf '%s\n' "$file"
    fi
  done
}

battery_require_no_external_config() {
  local conflicts
  conflicts="$(battery_external_config_sources)"
  if [[ -n "$conflicts" ]]; then
    fail "Existing user-managed TLP charge thresholds were found in: ${conflicts//$'\n'/, }. Awtarchy will not overwrite them."
  fi
}

battery_choose_start() {
  local target="$1" start_spec="$2" range min max candidate value
  local -a values=()

  [[ -n "$start_spec" ]] || { printf '0\n'; return 0; }
  if [[ "${start_spec,,}" == *"don't care"* || "${start_spec,,}" == *"not supported"* ]]; then
    printf '0\n'
    return 0
  fi

  if range="$(battery_parse_range "$start_spec" 2>/dev/null)"; then
    IFS=$'\t' read -r min max <<<"$range"
    (( min >= 0 && max <= 100 )) \
      || fail 'TLP reported an invalid start-threshold range'
    candidate=$(( target - 5 ))
    (( candidate < min )) && candidate="$min"
    (( candidate > max )) && candidate="$max"
    (( candidate < target )) || candidate=$(( target - 1 ))
    (( candidate >= min && candidate <= max && candidate < target )) \
      || fail "cannot derive a supported start threshold below ${target}%"
    printf '%s\n' "$candidate"
    return 0
  fi

  mapfile -t values < <(battery_parse_values "$start_spec")
  candidate=-1
  for value in "${values[@]}"; do
    (( value >= 0 && value <= 100 )) || continue
    (( value < target && value > candidate )) && candidate="$value"
  done
  if (( candidate >= 0 )); then
    printf '%s\n' "$candidate"
  else
    printf '0\n'
  fi
}

battery_validate_target() {
  local target="$1" stop_spec="$2" range min max
  local -a values=()

  [[ "$target" =~ ^[0-9]+$ ]] || fail 'battery target must be an integer percentage'
  (( target >= 1 && target <= 99 )) \
    || fail 'battery target must be between 1 and 99; use OFF for full charge'
  [[ -n "$stop_spec" ]] || fail 'TLP did not report a supported stop threshold'
  battery_spec_is_percentage_control "$stop_spec" \
    || fail 'TLP reports a non-percentage Battery Care mode; configure it with TLPUI'

  if range="$(battery_parse_range "$stop_spec" 2>/dev/null)"; then
    IFS=$'\t' read -r min max <<<"$range"
    (( target >= min && target <= max )) \
      || fail "target ${target}% is outside supported stop range ${min}-${max}%"
    return 0
  fi

  mapfile -t values < <(battery_parse_values "$stop_spec")
  battery_value_in_list "$target" "${values[@]}" \
    || fail "target ${target}% is not one of the supported charge targets"
}

battery_config_suffixes() {
  local report="$1" prefix="$2" parameter part base=""
  local -a parts=()

  parameter="$(
    /usr/bin/sed -n -E \
      "s/^\\*[[:space:]]+${prefix}_(BAT[0-9]+(\/[0-9]+)*):.*$/\\1/p" \
      <<<"$report" | /usr/bin/head -n1
  )"
  [[ -n "$parameter" ]] || return 1

  IFS='/' read -r -a parts <<<"$parameter"
  for part in "${parts[@]}"; do
    if [[ "$part" =~ ^([A-Z]+)([0-9]+)$ ]]; then
      base="${BASH_REMATCH[1]}"
      [[ "$base" == BAT ]] || return 1
      printf 'BAT%s\n' "${BASH_REMATCH[2]}"
    elif [[ -n "$base" && "$part" =~ ^[0-9]+$ ]]; then
      printf '%s%s\n' "$base" "$part"
    else
      return 1
    fi
  done
}

battery_require_config_path_safe() {
  local dir_owner dir_mode file_owner file_mode
  [[ -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]] \
    || fail "unsafe or missing TLP configuration directory: $CONFIG_DIR"
  dir_owner="$(/usr/bin/stat -c %u -- "$CONFIG_DIR" 2>/dev/null)" \
    || fail "cannot inspect TLP configuration directory: $CONFIG_DIR"
  dir_mode="$(/usr/bin/stat -c %a -- "$CONFIG_DIR" 2>/dev/null)" \
    || fail "cannot inspect TLP configuration directory permissions"
  [[ "$dir_owner" == 0 && "$dir_mode" =~ ^[0-7]{3,4}$ ]] \
    || fail "unsafe TLP configuration directory ownership: $CONFIG_DIR"
  (( (8#$dir_mode & 8#022) == 0 )) \
    || fail "TLP configuration directory is group/world writable: $CONFIG_DIR"

  if [[ -e "$MANAGED_CONFIG" || -L "$MANAGED_CONFIG" ]]; then
    [[ -f "$MANAGED_CONFIG" && ! -L "$MANAGED_CONFIG" ]] \
      || fail "refusing unsafe managed battery-care config: $MANAGED_CONFIG"
    file_owner="$(/usr/bin/stat -c %u -- "$MANAGED_CONFIG" 2>/dev/null)" \
      || fail "cannot inspect managed battery-care config"
    file_mode="$(/usr/bin/stat -c %a -- "$MANAGED_CONFIG" 2>/dev/null)" \
      || fail "cannot inspect managed battery-care config permissions"
    [[ "$file_owner" == 0 && "$file_mode" =~ ^[0-7]{3,4}$ ]] \
      || fail "unsafe managed battery-care config ownership"
    (( (8#$file_mode & 8#022) == 0 )) \
      || fail "managed battery-care config is group/world writable"
  fi
}

battery_write_config() {
  local target="$1" start_value="$2" stop_value="$3" suffix temporary
  shift 3
  (( $# > 0 )) || fail 'TLP did not advertise any charge-threshold config parameters'

  battery_require_config_path_safe
  temporary="$(/usr/bin/mktemp "${CONFIG_DIR}/.awtarchy-battery-care.XXXXXX")"
  {
    printf '%s\n' '# Managed by Awtarchy Battery flyout.'
    printf '# target=%s\n' "$target"
    for suffix in "$@"; do
      [[ "$suffix" =~ ^BAT[0-9]+$ ]] || fail "invalid TLP battery config suffix: $suffix"
      printf 'START_CHARGE_THRESH_%s=%s\n' "$suffix" "$start_value"
      printf 'STOP_CHARGE_THRESH_%s=%s\n' "$suffix" "$stop_value"
    done
  } >"$temporary"
  /usr/bin/chmod 0644 "$temporary"
  /usr/bin/mv -Tf -- "$temporary" "$MANAGED_CONFIG"
}

battery_saved_config_create() {
  local backup="$1"
  if [[ -f "$MANAGED_CONFIG" && ! -L "$MANAGED_CONFIG" ]]; then
    /usr/bin/cp -a -- "$MANAGED_CONFIG" "$backup"
    printf 'present\n'
  else
    printf 'absent\n'
  fi
}

battery_fullcharge_all() {
  local report name any=0 rc=0
  report="$(battery_tlp_report)"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    any=1
    if ! "$TLP" fullcharge "$name" >/dev/null; then
      rc=1
    fi
  done < <(/usr/bin/sed -n -E 's/^\+\+\+[[:space:]]+.*Battery Status:[[:space:]]*([^[:space:]]+).*$/\1/p' <<<"$report")
  if (( any == 0 )) && ! "$TLP" fullcharge >/dev/null; then
    rc=1
  fi
  return "$rc"
}

rollback_apply() {
  local previous_state="$1" backup="$2"

  if [[ "$previous_state" == present && -f "$backup" ]]; then
    /usr/bin/cp -a -- "$backup" "$MANAGED_CONFIG" || return 1
    "$TLP" setcharge >/dev/null 2>&1
  else
    /usr/bin/rm -f -- "$MANAGED_CONFIG" || return 1
    battery_fullcharge_all >/dev/null 2>&1
  fi
}

battery_fail_after_rollback() {
  local previous_state="$1" backup="$2" reason="$3"

  if rollback_apply "$previous_state" "$backup"; then
    /usr/bin/rm -f -- "$backup"
    fail "${reason}; previous settings were restored"
  fi

  /usr/bin/rm -f -- "$backup"
  fail "${reason}; previous configuration state was restored, but TLP could not re-apply it"
}

battery_set_target() {
  local target="$1" report start_spec stop_spec start_value backup previous_state
  local -a suffixes=()

  [[ -x "$TLP" && -x "$TLP_STAT" ]] || fail 'TLP battery-care tools are unavailable'
  battery_require_no_external_config
  report="$(battery_tlp_report)"
  battery_require_capability "$report"
  start_spec="$(battery_parse_spec "$report" START_CHARGE_THRESH)"
  stop_spec="$(battery_parse_spec "$report" STOP_CHARGE_THRESH)"
  battery_validate_target "$target" "$stop_spec"
  start_value="$(battery_choose_start "$target" "$start_spec")"
  mapfile -t suffixes < <(battery_config_suffixes "$report" STOP_CHARGE_THRESH)
  (( ${#suffixes[@]} > 0 )) \
    || fail 'TLP did not advertise usable charge-threshold config parameters'

  backup="$(/usr/bin/mktemp /tmp/awtarchy-battery-care.backup.XXXXXX)"
  previous_state="$(battery_saved_config_create "$backup")"
  battery_write_config "$target" "$start_value" "$target" "${suffixes[@]}"
  if ! "$TLP" setcharge >/dev/null; then
    battery_fail_after_rollback "$previous_state" "$backup" 'TLP failed to apply the requested battery charge limit'
  fi
  /usr/bin/rm -f -- "$backup"
}

battery_disable() {
  local backup previous_state

  [[ -x "$TLP" && -x "$TLP_STAT" ]] || fail 'TLP battery-care tools are unavailable'
  battery_require_no_external_config
  battery_require_config_path_safe

  backup="$(/usr/bin/mktemp /tmp/awtarchy-battery-care.backup.XXXXXX)"
  previous_state="$(battery_saved_config_create "$backup")"
  /usr/bin/rm -f -- "$MANAGED_CONFIG"
  if ! battery_fullcharge_all; then
    battery_fail_after_rollback "$previous_state" "$backup" 'TLP failed to restore full-charge defaults'
  fi
  /usr/bin/rm -f -- "$backup"
}

main() {
  local action="${1:-}"

  case "$action" in
    setup|resolve-tlp-conflict|battery-disable)
      [[ $# -eq 1 ]] || fail "${action} does not accept extra arguments"
      ;;
    battery-set)
      [[ $# -eq 2 ]] || fail 'battery-set requires exactly one percentage target'
      ;;
    *) fail "unsupported action: ${action:-<none>}" ;;
  esac

  (( EUID == 0 )) || fail 'must run as root'

  case "$action" in
    setup|resolve-tlp-conflict)
      [[ -x "$PACMAN" && -x "$SYSTEMCTL" && -x /usr/bin/grep && -x /usr/bin/cat ]] \
        || fail 'required system tools are unavailable'
      is_laptop || fail 'Power Mode setup is only supported on laptop hardware'
      if [[ "$action" == setup ]]; then
        setup_backend
      else
        resolve_tlp_conflict
      fi
      ;;
    battery-set)
      battery_set_target "$2"
      ;;
    battery-disable)
      battery_disable
      ;;
  esac
}

main "$@"
