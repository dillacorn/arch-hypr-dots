#!/usr/bin/env bash
# Temporary Awtarchy conversion shim for legacy theme/scripts during testing.

set -u

if command -v qs >/dev/null 2>&1 && qs -c awtarchy ipc call control ping >/dev/null 2>&1; then
    case "${1:-}" in
        reload) exit 0 ;;
        dismiss)
            if [[ "${2:-}" == "-a" ]]; then
                exec qs -c awtarchy ipc call notifications dismissAll
            fi
            exec qs -c awtarchy ipc call notifications dismissFirst
            ;;
        mode)
            case "${2:-}" in
                -a) exec qs -c awtarchy ipc call notifications disable ;;
                -r) exec qs -c awtarchy ipc call notifications enable ;;
                *)
                    if [[ "$(qs -c awtarchy ipc call notifications dndEnabled 2>/dev/null || printf false)" == "true" ]]; then
                        printf 'do-not-disturb\n'
                    fi
                    exit 0
                    ;;
            esac
            ;;
    esac
fi

exec /usr/bin/makoctl "$@"
