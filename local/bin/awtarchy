#!/usr/bin/env bash
# github.com/dillacorn/awtarchy
# Installed Awtarchy maintenance command and self-updater.

set -Eeuo pipefail
IFS=$'\n\t'
umask 022

REPO_OWNER="dillacorn"
REPO_NAME="awtarchy"
UPDATER_BRANCH="main"
TARGET_USER=""
TARGET_HOME=""
DATA_HOME=""
STATE_HOME=""
INSTALL_DIR=""
RUNTIME=""
PACKAGE_RECONCILER=""
COMMAND_VERSION_FILE=""
CONFIG_VERSION_FILE=""
GIT_TEST_STATE_FILE=""

log()  { printf '%s\n' "$*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

drop_launcher_privileges() {
  local target_user="${SUDO_USER:-}" passwd_entry=""
  local account="" uid="" home=""
  local launcher_path=""
  local -a passwd_fields=()

  [[ ${EUID} -ne 0 ]] && return 0
  [[ -n $target_user && $target_user != root ]] || return 0

  passwd_entry="$(/usr/bin/getent passwd "$target_user" || true)"
  IFS=: read -r -a passwd_fields <<<"$passwd_entry"
  account="${passwd_fields[0]:-}"
  uid="${passwd_fields[2]:-}"
  home="${passwd_fields[5]:-}"
  [[ $account == "$target_user" && $uid =~ ^[0-9]+$ && $uid -ne 0 ]] \
    || die "Could not validate the invoking user before dropping privileges."
  [[ $home == /* && -d $home ]] \
    || die "Could not validate the invoking user's home directory."
  launcher_path="$(/usr/bin/readlink -f -- "$0")"
  [[ -n $launcher_path && -f $launcher_path ]] \
    || die "Could not resolve the Awtarchy launcher before dropping privileges."

  exec /usr/bin/runuser -u "$target_user" -- /usr/bin/env \
    -u SUDO_USER -u SUDO_UID -u SUDO_GID \
    -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME -u XDG_CACHE_HOME \
    -u XDG_RUNTIME_DIR -u DBUS_SESSION_BUS_ADDRESS \
    HOME="$home" USER="$target_user" LOGNAME="$target_user" \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin \
    "$launcher_path" "$@"
}

init_target() {
  if [[ ${EUID} -eq 0 && -n ${SUDO_USER:-} && ${SUDO_USER} != root ]]; then
    TARGET_USER="$SUDO_USER"
    TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6 || true)"
  else
    TARGET_USER="${USER:-$(id -un)}"
    TARGET_HOME="${HOME:-}"
  fi

  [[ -n $TARGET_USER ]] || die "Could not determine target user."
  [[ -n $TARGET_HOME && -d $TARGET_HOME ]] || die "Could not determine home directory for ${TARGET_USER}."

  DATA_HOME="${XDG_DATA_HOME:-${TARGET_HOME}/.local/share}"
  STATE_HOME="${XDG_STATE_HOME:-${TARGET_HOME}/.local/state}"
  INSTALL_DIR="${DATA_HOME}/awtarchy"
  RUNTIME="${INSTALL_DIR}/awtarchy-runtime.sh"
  PACKAGE_RECONCILER="${INSTALL_DIR}/awtarchy-package-reconcile.sh"
  COMMAND_VERSION_FILE="${STATE_HOME}/awtarchy/command-version"
  CONFIG_VERSION_FILE="${STATE_HOME}/awtarchy/config-version"
  GIT_TEST_STATE_FILE="${STATE_HOME}/awtarchy/git-testing"
}

cleanup_legacy_quickshell_command() {
  local legacy_launcher="${TARGET_HOME}/.local/bin/awtarchy-quickshell"
  local legacy_data="${DATA_HOME}/awtarchy-quickshell"
  local legacy_state_dir="${STATE_HOME}/awtarchy-quickshell"
  local legacy_command_state="${legacy_state_dir}/command-version"
  local marker='Temporary branch-only maintenance command for the Quickshell migration.'
  local recognized=0 removed=0

  if [[ -f $legacy_launcher && ! -L $legacy_launcher ]]; then
    if grep -Fq -- "$marker" "$legacy_launcher"; then
      recognized=1
      rm -f -- "$legacy_launcher"
      removed=1
    fi
  elif [[ ! -e $legacy_launcher && ! -L $legacy_launcher ]]; then
    recognized=1
  fi

  if (( recognized == 1 )); then
    if [[ -e $legacy_data || -L $legacy_data ]]; then
      rm -rf -- "$legacy_data"
      removed=1
    fi
    if [[ -f $legacy_command_state && ! -L $legacy_command_state ]]; then
      rm -f -- "$legacy_command_state"
      removed=1
      rmdir -- "$legacy_state_dir" 2>/dev/null || true
    fi
  fi

  (( removed == 0 )) || log "Removed obsolete awtarchy-quickshell testing command state."
}

ensure_vpn_directory() {
  local vpn_dir="${TARGET_HOME}/vpn"
  if [[ ${EUID} -eq 0 && $TARGET_USER != root ]]; then
    runuser -u "$TARGET_USER" -- install -d -m 0700 -- "$vpn_dir"
  else
    install -d -m 0700 -- "$vpn_dir"
  fi
}

state_value() {
  local key="$1" file="$2"
  [[ -r $file ]] || return 1
  sed -n "s/^${key}=//p" "$file" | head -n1
}

installed_updater_commit() {
  local revision=""
  revision="$(state_value revision "$COMMAND_VERSION_FILE" 2>/dev/null || true)"
  if [[ $revision =~ ^[0-9a-fA-F]{40}$ ]]; then
    printf '%s\n' "${revision,,}"
  else
    printf '%s\n' unknown
  fi
}

installed_config_tag() {
  local tag=""
  tag="$(state_value tag "$CONFIG_VERSION_FILE" 2>/dev/null || true)"
  if [[ -z $tag ]]; then
    tag="$(state_value tag "${STATE_HOME}/awtarchy/baseline/metadata" 2>/dev/null || true)"
  fi
  [[ -n $tag ]] && printf '%s\n' "$tag" || printf '%s\n' unknown
}

curl_args() {
  local mode="${1:-api}"
  CURL_ARGS=(
    -fL
    --show-error
    --connect-timeout 5
    --retry 1
    -H "Accept: application/vnd.github+json"
    -H "User-Agent: awtarchy-command"
  )
  case "$mode" in
    api)
      CURL_ARGS+=(--silent --max-time 10)
      ;;
    download)
      CURL_ARGS+=(
        --max-time 300
        --retry 2
        --retry-delay 1
        --speed-limit 1024
        --speed-time 30
        --progress-bar
      )
      ;;
    *) die "Unknown curl mode: ${mode}" ;;
  esac
  if [[ -n ${GITHUB_TOKEN:-} ]]; then
    CURL_ARGS+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
  fi
}

latest_release_tag() {
  have curl || return 1
  have python3 || return 1
  curl_args api
  local json=""
  json="$(curl "${CURL_ARGS[@]}" "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest")" || return 1
  python3 - "$json" <<'PY'
import json
import sys

try:
    payload = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    raise SystemExit(1)

tag = str(payload.get("tag_name") or "").strip()
if not tag:
    raise SystemExit(1)
print(tag)
PY
}

requested_config_tag() {
  local tag=""
  while (( $# > 0 )); do
    case "$1" in
      --tag)
        shift
        (( $# > 0 )) || die "--tag requires a value."
        tag="$1"
        ;;
    esac
    shift
  done

  if [[ -n $tag ]]; then
    printf '%s\n' "$tag"
    return 0
  fi

  latest_release_tag || die "Could not determine the latest Awtarchy config release."
}

parse_github_git_object() {
  python3 - "$1" <<'PY'
import json
import re
import sys

try:
    payload = json.loads(sys.argv[1])
    obj = payload["object"]
    kind = str(obj["type"]).strip()
    revision = str(obj["sha"]).strip().lower()
except (IndexError, KeyError, TypeError, json.JSONDecodeError):
    raise SystemExit(1)
if kind not in {"commit", "tag"} or not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit(1)
print(kind)
print(revision)
PY
}

resolve_published_release_tag_commit() {
  local tag="$1" tag_enc="" release_json="" object_json=""
  local kind="" revision="" depth=0
  local -a object_fields=()
  local -A seen=()

  have curl || return 1
  have python3 || return 1
  tag_enc="$(urlencode_ref "$tag")" || return 1
  curl_args api
  release_json="$(curl "${CURL_ARGS[@]}" \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/tags/${tag_enc}")" \
    || return 1
  python3 - "$release_json" "$tag" <<'PY' || return 1
import json
import sys

try:
    payload = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    raise SystemExit(1)
if (
    str(payload.get("tag_name") or "") != sys.argv[2]
    or payload.get("draft") is not False
    or not str(payload.get("published_at") or "").strip()
):
    raise SystemExit(1)
PY

  object_json="$(curl "${CURL_ARGS[@]}" \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/git/ref/tags/${tag_enc}")" \
    || return 1
  mapfile -t object_fields < <(parse_github_git_object "$object_json")
  (( ${#object_fields[@]} == 2 )) || return 1
  kind="${object_fields[0]}"
  revision="${object_fields[1]}"

  while (( depth < 8 )); do
    case "$kind" in
      commit)
        printf '%s\n' "$revision"
        return 0
        ;;
      tag)
        [[ -z ${seen[$revision]:-} ]] || return 1
        seen[$revision]=1
        object_json="$(curl "${CURL_ARGS[@]}" \
          "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/git/tags/${revision}")" \
          || return 1
        object_fields=()
        mapfile -t object_fields < <(parse_github_git_object "$object_json")
        (( ${#object_fields[@]} == 2 )) || return 1
        kind="${object_fields[0]}"
        revision="${object_fields[1]}"
        ;;
      *) return 1 ;;
    esac
    (( depth += 1 ))
  done
  return 1
}

commit_has_quickshell_payload() {
  local revision="$1"
  [[ $revision =~ ^[0-9a-f]{40}$ ]] || return 1
  have curl || return 1
  curl_args api
  curl "${CURL_ARGS[@]}" \
    --get \
    --data-urlencode "ref=${revision}" \
    --output /dev/null \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/local/share/awtarchy/quickshell-managed-history.sha256" \
    2>/dev/null
}

release_has_quickshell_payload() {
  local tag="$1" revision=""
  revision="$(resolve_published_release_tag_commit "$tag")" || return 2
  commit_has_quickshell_payload "$revision"
}

config_release_ready_or_noop() {
  local tag installed rc=0
  tag="$(requested_config_tag "$@")" || rc=$?
  (( rc == 0 )) || return "$rc"

  if release_has_quickshell_payload "$tag"; then
    return 0
  else
    rc=$?
  fi

  (( rc != 2 )) \
    || die "Config target ${tag} is not an exact published Awtarchy release tag. Use 'awtarchy git' for branch or commit testing."

  installed="$(installed_config_tag)"
  if [[ $installed == "$tag" ]]; then
    log "Config release ${tag} predates the Quickshell migration and is already installed. No managed files changed."
    return 1
  fi

  die "Config release ${tag} predates the Quickshell migration. No managed files were changed; publish or select a Quickshell-capable release before updating."
}

config_is_git_testing() {
  local installed=""
  installed="$(installed_config_tag)"
  [[ $installed =~ ^.+@[0-9a-fA-F]{40}$ ]]
}

require_git_compatible_main() {
  local remote="$1"
  commit_has_quickshell_payload "$remote" \
    || die "Current main does not contain the Quickshell-capable updater required by active Git-testing state. No command or config files were changed."
}

protect_git_state_before_updater_refresh() {
  local remote=""
  config_is_git_testing || return 0

  config_release_ready_or_noop "$@"
  remote="$(updater_branch_head)" \
    || die "Could not determine the current main updater before leaving Git-testing state."
  require_git_compatible_main "$remote"
}

self_update_safely() {
  local remote=""
  if config_is_git_testing; then
    remote="$(updater_branch_head)" \
      || die "Could not determine the current main updater before refreshing active Git-testing state."
    require_git_compatible_main "$remote"
    self_update "$remote"
  else
    self_update
  fi
}

updater_branch_head() {
  have curl || return 1
  have python3 || return 1
  curl_args api

  curl "${CURL_ARGS[@]}" \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/commits/${UPDATER_BRANCH}" \
    | python3 -c '
import json
import re
import sys

try:
    payload = json.load(sys.stdin)
except (TypeError, json.JSONDecodeError):
    raise SystemExit(1)

revision = str(payload.get("sha") or "").strip().lower()
if not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit(1)
print(revision)
'
}

urlencode_ref() {
  have python3 || return 1
  python3 - "$1" <<'PY'
import sys
from urllib.parse import quote

print(quote(sys.argv[1], safe=""))
PY
}

github_api() {
  local url="$1"
  have curl || return 1
  curl_args api
  curl "${CURL_ARGS[@]}" "$url"
}

remote_git_branches() {
  have python3 || return 1

  local page=1 json="" parsed=""
  local -a page_branches=() all_branches=()
  while true; do
    json="$(github_api \
      "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/branches?per_page=100&page=${page}")" \
      || return 1
    parsed="$(python3 - "$json" <<'PY'
import json
import re
import sys

try:
    payload = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(payload, list):
    raise SystemExit(1)

for item in payload:
    if not isinstance(item, dict):
        raise SystemExit(1)
    name = item.get("name")
    revision = (item.get("commit") or {}).get("sha")
    if not isinstance(name, str) or not name or "\n" in name or "\t" in name:
        raise SystemExit(1)
    if not isinstance(revision, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", revision):
        raise SystemExit(1)
    print(name)
PY
)" || return 1

    page_branches=()
    if [[ -n $parsed ]]; then
      mapfile -t page_branches <<<"$parsed"
      all_branches+=("${page_branches[@]}")
    fi
    (( ${#page_branches[@]} == 100 )) || break
    ((page++)) || true
  done

  (( ${#all_branches[@]} > 0 )) || return 1
  printf '%s\n' "${all_branches[@]}" | LC_ALL=C sort -u
}

remote_git_branch_head() {
  local branch="$1" encoded="" json=""
  have python3 || return 1
  encoded="$(urlencode_ref "$branch")" || return 1
  json="$(github_api \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/branches/${encoded}")" \
    || return 1

  python3 - "$json" "$branch" <<'PY'
import json
import re
import sys

try:
    payload = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    raise SystemExit(1)

expected = sys.argv[2]
name = str(payload.get("name") or "")
revision = str((payload.get("commit") or {}).get("sha") or "").lower()
if name != expected or not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit(1)
print(revision)
PY
}

git_commit_belongs_to_branch() {
  local commit="$1" branch_head="$2" json=""
  [[ $commit == "$branch_head" ]] && return 0
  have python3 || return 1

  json="$(github_api \
    "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/compare/${commit}...${branch_head}")" \
    || return 1
  python3 - "$json" "$commit" <<'PY'
import json
import sys

try:
    payload = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    raise SystemExit(1)

requested = sys.argv[2].lower()
status = str(payload.get("status") or "")
merge_base = str((payload.get("merge_base_commit") or {}).get("sha") or "").lower()
if status not in {"ahead", "identical"} or merge_base != requested:
    raise SystemExit(1)
PY
}

archive_topdir() {
  python3 - "$1" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

with tarfile.open(sys.argv[1], "r:gz") as archive:
    members = archive.getmembers()
    if not members:
        raise SystemExit(1)
    top = ""
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit("unsafe archive path")
        if not (member.isfile() or member.isdir()):
            raise SystemExit("unsupported archive entry")
        if path.parts and not top:
            top = path.parts[0]
        elif path.parts and path.parts[0] != top:
            raise SystemExit("archive has multiple top-level paths")
    if not top:
        raise SystemExit(1)
    print(top)
PY
}

atomic_install() {
  local src="$1" dest="$2" mode="$3" dir tmp
  dir="$(dirname "$dest")"
  mkdir -p -- "$dir"
  tmp="$(mktemp --tmpdir="$dir" ".$(basename "$dest").tmp.XXXXXX")"
  install -m "$mode" -- "$src" "$tmp"
  if [[ ${EUID} -eq 0 ]]; then
    chown "$TARGET_USER:$TARGET_USER" "$tmp"
  fi
  mv -Tf -- "$tmp" "$dest"
}

write_command_version() {
  local revision="$1" tmp dir
  dir="$(dirname "$COMMAND_VERSION_FILE")"
  mkdir -p -- "$dir"
  tmp="$(mktemp --tmpdir="$dir" '.command-version.tmp.XXXXXX')"
  {
    printf 'tag=%s\n' "$UPDATER_BRANCH"
    printf 'revision=%s\n' "$revision"
    printf 'updated_at=%s\n' "$(date -Iseconds)"
  } >"$tmp"
  chmod 0644 "$tmp"
  if [[ ${EUID} -eq 0 ]]; then
    chown "$TARGET_USER:$TARGET_USER" "$tmp"
  fi
  mv -Tf -- "$tmp" "$COMMAND_VERSION_FILE"
}

self_update() {
  local commit="${1:-}" installed tmp archive top repo_dir
  local new_runtime new_launcher new_package_reconciler

  have curl || die "curl is required for self-update."
  have tar || die "tar is required for self-update."
  have python3 || die "python3 is required for self-update."

  [[ -n $commit ]] || commit="$(updater_branch_head)" \
    || die "Could not resolve the current ${UPDATER_BRANCH} updater head."
  [[ $commit =~ ^[0-9a-fA-F]{40}$ ]] \
    || die "Updater branch returned an invalid commit SHA."
  commit="${commit,,}"

  installed="$(installed_updater_commit)"
  if [[ $installed == "$commit" && -x $PACKAGE_RECONCILER ]]; then
    log "Awtarchy updater is already current at ${UPDATER_BRANCH}@${commit}."
    return 0
  fi

  tmp="$(mktemp -d)"
  archive="${tmp}/awtarchy.tar.gz"

  curl_args download
  log "Downloading Awtarchy updater ${UPDATER_BRANCH}@${commit} (stalled transfers abort after 30 seconds)..."
  if ! curl "${CURL_ARGS[@]}" -o "$archive" \
    "https://github.com/${REPO_OWNER}/${REPO_NAME}/archive/${commit}.tar.gz";
  then
    rm -rf -- "$tmp"
    die "Failed to download updater commit ${commit}."
  fi

  top="$(archive_topdir "$archive")" || {
    rm -rf -- "$tmp"
    die "Updater archive validation failed."
  }
  [[ $top == "${REPO_NAME}-${commit}" ]] || {
    rm -rf -- "$tmp"
    die "Updater archive does not match commit ${commit}."
  }

  tar -xzf "$archive" -C "$tmp"
  repo_dir="${tmp}/${top}"
  new_runtime="${repo_dir}/local/share/awtarchy/awtarchy-runtime.sh"
  new_launcher="${repo_dir}/local/bin/awtarchy"
  new_package_reconciler="${repo_dir}/local/share/awtarchy/awtarchy-package-reconcile.sh"

  [[ -f $new_runtime ]] || {
    rm -rf -- "$tmp"
    die "Updater commit ${commit} does not contain the Awtarchy runtime."
  }
  [[ -f $new_launcher ]] || {
    rm -rf -- "$tmp"
    die "Updater commit ${commit} does not contain the Awtarchy command."
  }
  [[ -f $new_package_reconciler && ! -L $new_package_reconciler ]] || {
    rm -rf -- "$tmp"
    die "Updater commit ${commit} does not contain the package reconciler."
  }
  bash -n "$new_runtime" || {
    rm -rf -- "$tmp"
    die "Downloaded Awtarchy runtime failed Bash syntax validation."
  }
  bash -n "$new_launcher" || {
    rm -rf -- "$tmp"
    die "Downloaded Awtarchy command failed Bash syntax validation."
  }
  bash -n "$new_package_reconciler" || {
    rm -rf -- "$tmp"
    die "Downloaded Awtarchy package reconciler failed Bash syntax validation."
  }
  atomic_install "$new_runtime" "$RUNTIME" 0755
  atomic_install "$new_launcher" "${TARGET_HOME}/.local/bin/awtarchy" 0755
  atomic_install "$new_package_reconciler" "$PACKAGE_RECONCILER" 0755
  write_command_version "$commit"
  rm -rf -- "$tmp"

  log "Awtarchy updater refreshed to ${UPDATER_BRANCH}@${commit}."
}

ensure_latest_updater() {
  [[ ${AWTARCHY_SKIP_UPDATE_CHECK:-0} == 1 ]] && return 0

  local installed remote
  installed="$(installed_updater_commit)"
  remote="$(updater_branch_head)" \
    || die "Could not determine the latest Awtarchy updater from ${UPDATER_BRANCH}."

  if [[ $installed != "$remote" ]]; then
    self_update "$remote"
    exec "${TARGET_HOME}/.local/bin/awtarchy" "$@"
  fi
}

print_version_status() {
  local installed remote="" updater_status="Remote main unavailable"
  local config latest="" config_status="Latest release unavailable"
  local git_status="inactive" git_branch="" git_revision="" stable_predecessor=""

  installed="$(installed_updater_commit)"
  config="$(installed_config_tag)"

  if [[ -r $GIT_TEST_STATE_FILE ]]; then
    git_branch="$(state_value branch "$GIT_TEST_STATE_FILE" 2>/dev/null || true)"
    git_revision="$(state_value revision "$GIT_TEST_STATE_FILE" 2>/dev/null || true)"
    stable_predecessor="$(state_value stable_release "$GIT_TEST_STATE_FILE" 2>/dev/null || true)"
  fi
  if [[ -n $git_branch && $git_revision =~ ^[0-9a-fA-F]{40}$ ]]; then
    git_revision="${git_revision,,}"
    if [[ $config == "${git_branch}@${git_revision}" ]]; then
      git_status="active"
    else
      git_branch=""
      git_revision=""
      stable_predecessor=""
    fi
  fi
  if [[ $git_status != active && $config =~ ^(.+)@([0-9a-fA-F]{40})$ ]]; then
    git_status="active"
    git_branch="${BASH_REMATCH[1]}"
    git_revision="${BASH_REMATCH[2],,}"
    stable_predecessor="${stable_predecessor:-unknown}"
  fi

  if remote="$(updater_branch_head 2>/dev/null)"; then
    if [[ $installed == "$remote" ]]; then
      updater_status="Up to date"
    elif [[ $installed == unknown ]]; then
      updater_status="Updater state is untracked or from the legacy release-based updater"
    else
      updater_status="Updater refresh available"
    fi
  fi

  if latest="$(latest_release_tag 2>/dev/null)"; then
    if [[ $config == "$latest" ]]; then
      config_status="Up to date"
    elif [[ $config == unknown || $config == unreleased ]]; then
      config_status="Local or untracked config build"
    else
      config_status="Config update available"
    fi
  fi
  if [[ $git_status == active ]]; then
    config_status="Git testing state; awtarchy update returns to a Quickshell-capable release"
  fi

  printf 'Updater branch:     %s\n' "$UPDATER_BRANCH"
  printf 'Updater commit:     %s\n' "$installed"
  printf 'Remote main head:   %s\n' "${remote:-unavailable}"
  printf 'Updater status:     %s\n' "$updater_status"
  printf 'Config release:     %s\n' "$config"
  printf 'Latest release:     %s\n' "${latest:-unavailable}"
  printf 'Config status:      %s\n' "$config_status"
  printf 'Git testing:        %s\n' "$git_status"
  if [[ $git_status == active ]]; then
    printf 'Git branch:         %s\n' "$git_branch"
    printf 'Git revision:       %s\n' "$git_revision"
    printf 'Stable predecessor: %s\n' "${stable_predecessor:-unknown}"
  fi
}

require_runtime() {
  [[ -f $RUNTIME ]] || die "Installed runtime is missing: ${RUNTIME}. Run awtarchy-install.sh once to repair it."
}

run_runtime() {
  require_runtime
  bash "$RUNTIME" "$@"
}

run_git_revision_runtime() {
  local branch="$1" revision="$2"
  shift 2
  local tmp="" archive="" top="" repo_dir="" testing_runtime="" rc=0

  have curl || die "curl is required for Git-testing runtime selection."
  have tar || die "tar is required for Git-testing runtime selection."
  have python3 || die "python3 is required for Git-testing runtime selection."
  [[ $revision =~ ^[0-9a-fA-F]{40}$ ]]     || die "Git-testing runtime requires an exact 40-character commit SHA."
  revision="${revision,,}"

  tmp="$(mktemp -d)"
  archive="${tmp}/awtarchy.tar.gz"
  curl_args download
  log "Loading Awtarchy runtime from Git testing ${branch}@${revision}..."
  if ! curl "${CURL_ARGS[@]}" -o "$archive"     "https://github.com/${REPO_OWNER}/${REPO_NAME}/archive/${revision}.tar.gz";
  then
    rm -rf -- "$tmp"
    die "Failed to download Git-testing runtime revision ${revision}."
  fi

  if ! top="$(archive_topdir "$archive")"; then
    rm -rf -- "$tmp"
    die "Git-testing runtime archive validation failed."
  fi
  if ! [[ $top == "${REPO_NAME}-${revision}" ]]; then
    rm -rf -- "$tmp"
    die "Git-testing runtime archive does not match revision ${revision}."
  fi
  if ! tar -xzf "$archive" -C "$tmp"; then
    rm -rf -- "$tmp"
    die "Failed to extract Git-testing runtime revision ${revision}."
  fi

  repo_dir="${tmp}/${top}"
  testing_runtime="${repo_dir}/local/share/awtarchy/awtarchy-runtime.sh"
  if ! [[ -f $testing_runtime && ! -L $testing_runtime ]]; then
    rm -rf -- "$tmp"
    die "Git-testing revision ${revision} does not contain a safe Awtarchy runtime."
  fi
  if ! bash -n "$testing_runtime"; then
    rm -rf -- "$tmp"
    die "Git-testing runtime failed Bash syntax validation."
  fi

  bash "$testing_runtime" "$@" || rc=$?
  rm -rf -- "$tmp"
  return "$rc"
}

exec_runtime() {
  require_runtime
  exec bash "$RUNTIME" "$@"
}

require_package_reconciler() {
  if [[ -x $PACKAGE_RECONCILER && ! -L $PACKAGE_RECONCILER ]]; then
    return 0
  fi

  local remote=""
  remote="$(updater_branch_head)" \
    || die "Could not determine the current updater while repairing the package reconciler."
  self_update "$remote"
  [[ -x $PACKAGE_RECONCILER && ! -L $PACKAGE_RECONCILER ]] \
    || die "Package reconciler is unavailable after updater repair: ${PACKAGE_RECONCILER}"
}

run_git_testing_package_reconciler() {
  local config="" branch="" revision="" tmp="" archive="" top="" repo_dir=""
  local testing_runtime="" testing_reconciler="" rc=0

  config="$(installed_config_tag)"
  [[ $config =~ ^(.+)@([0-9a-fA-F]{40})$ ]] \
    || die "Active Git-testing configuration has no valid exact revision for package reconciliation."
  branch="${BASH_REMATCH[1]}"
  revision="${BASH_REMATCH[2],,}"

  have curl || die "curl is required for Git-testing package reconciliation."
  have tar || die "tar is required for Git-testing package reconciliation."
  have python3 || die "python3 is required for Git-testing package reconciliation."

  tmp="$(mktemp -d)"
  archive="${tmp}/awtarchy.tar.gz"
  curl_args download
  log "Loading package reconciler from Git testing ${branch}@${revision}..."
  if ! curl "${CURL_ARGS[@]}" -o "$archive" \
    "https://github.com/${REPO_OWNER}/${REPO_NAME}/archive/${revision}.tar.gz";
  then
    rm -rf -- "$tmp"
    die "Failed to download active Git-testing revision ${revision}."
  fi

  top="$(archive_topdir "$archive")" || {
    rm -rf -- "$tmp"
    die "Git-testing package archive validation failed."
  }
  [[ $top == "${REPO_NAME}-${revision}" ]] || {
    rm -rf -- "$tmp"
    die "Git-testing package archive does not match revision ${revision}."
  }

  if ! tar -xzf "$archive" -C "$tmp"; then
    rm -rf -- "$tmp"
    die "Failed to extract Git-testing package archive for revision ${revision}."
  fi
  repo_dir="${tmp}/${top}"
  testing_runtime="${repo_dir}/local/share/awtarchy/awtarchy-runtime.sh"
  testing_reconciler="${repo_dir}/local/share/awtarchy/awtarchy-package-reconcile.sh"

  [[ -f $testing_runtime && ! -L $testing_runtime ]] || {
    rm -rf -- "$tmp"
    die "Git-testing revision ${revision} does not contain a safe Awtarchy runtime."
  }
  [[ -f $testing_reconciler && ! -L $testing_reconciler ]] || {
    rm -rf -- "$tmp"
    die "Git-testing revision ${revision} does not contain a safe package reconciler."
  }
  bash -n "$testing_runtime" || {
    rm -rf -- "$tmp"
    die "Git-testing runtime failed Bash syntax validation."
  }
  bash -n "$testing_reconciler" || {
    rm -rf -- "$tmp"
    die "Git-testing package reconciler failed Bash syntax validation."
  }

  AWTARCHY_RUNTIME="$testing_runtime" bash "$testing_reconciler" "$@" || rc=$?
  rm -rf -- "$tmp"
  return "$rc"
}

run_package_reconciler() {
  if config_is_git_testing; then
    run_git_testing_package_reconciler "$@"
    return $?
  fi

  require_package_reconciler
  AWTARCHY_RUNTIME="$RUNTIME" bash "$PACKAGE_RECONCILER" "$@"
}

offer_package_reconciliation_before_update() {
  local arg="" answer="" rc=0

  for arg in "$@"; do
    [[ $arg == --review-only ]] && return 0
  done

  if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty || ! -w /dev/tty ]]; then
    return 0
  fi

  require_package_reconciler
  if AWTARCHY_RUNTIME="$RUNTIME" bash "$PACKAGE_RECONCILER" --needs-action >/dev/null 2>&1; then
    return 0
  else
    rc=$?
  fi

  if (( rc != 10 )); then
    printf 'WARN: Could not determine Awtarchy package drift; continuing with the config update.\n' >&2
    return 0
  fi

  printf '\nAwtarchy detected missing, replaced, or retired Awtarchy-managed packages.\n' >/dev/tty
  printf 'Review/install package changes before updating configs? [Y/n] ' >/dev/tty
  IFS= read -r answer </dev/tty || answer=''
  case "$answer" in
    n|N|no|NO)
      printf 'Skipping package reconciliation; continuing with the config update.\n' >/dev/tty
      return 0
      ;;
  esac

  AWTARCHY_RUNTIME="$RUNTIME" bash "$PACKAGE_RECONCILER"
}

run_failure_reports() {
  local report_helper="${TARGET_HOME}/.config/hypr/scripts/awtarchy_report_failure.sh"
  [[ -f "$report_helper" && ! -L "$report_helper" && -O "$report_helper" ]] \
    || die "Awtarchy failure reporting is unavailable. Run 'awtarchy update' to restore the managed reporting helper."
  bash "$report_helper" pending
}

replace_quickshell_ui_from_baseline() {
  local rel="$1" baseline_root="$2" stamp="$3"
  local baseline="${baseline_root}/${rel}"
  local live="${TARGET_HOME}/${rel}"
  local backup="${live}.backup.${stamp}" tmp=""

  [[ -f "$baseline" && ! -L "$baseline" ]] || return 0
  mkdir -p -- "$(dirname -- "$live")"
  if [[ -e "$live" || -L "$live" ]]; then
    cp -a -- "$live" "$backup"
    printf 'Backup: %s\n' "$backup"
  fi
  tmp="$(mktemp --tmpdir="$(dirname -- "$live")" '.awtarchy-ui.tmp.XXXXXX')"
  install -m "$(stat -c '%a' "$baseline")" -- "$baseline" "$tmp"
  mv -Tf -- "$tmp" "$live"
  printf 'Updated: %s\n' "$rel"
}

reconcile_quickshell_ui_after_update() {
  local baseline_root="${STATE_HOME}/awtarchy/baseline/home"
  local stamp="" rel="" baseline="" live=""
  local choice="" per_file="" replaced=0 manager=""
  local -a ui_files=(
    ".config/quickshell/awtarchy/AudioLimitState.qml"
    ".config/quickshell/awtarchy/Bar.qml"
    ".config/quickshell/awtarchy/BarSettingsSection.qml"
    ".config/quickshell/awtarchy/CaptureEyeButton.qml"
    ".config/quickshell/awtarchy/FlyoutSettings.qml"
    ".config/quickshell/awtarchy/Launcher.qml"
    ".config/quickshell/awtarchy/Notifications.qml"
    ".config/quickshell/awtarchy/QuickSettings.qml"
  )
  local -a differences=()

  stamp="$(date +%Y%m%d-%H%M%S)"
  [[ -d "$baseline_root" ]] || return 0
  for rel in "${ui_files[@]}"; do
    baseline="${baseline_root}/${rel}"
    live="${TARGET_HOME}/${rel}"
    [[ -f "$baseline" && ! -L "$baseline" ]] || continue
    if [[ ! -f "$live" || -L "$live" ]] || ! cmp -s -- "$baseline" "$live"; then
      differences+=("$rel")
    fi
  done
  (( ${#differences[@]} > 0 )) || return 0

  printf '\nAwtarchy preserved local Quickshell UI files that differ from the current managed version:\n' >&2
  printf '  %s\n' "${differences[@]}" >&2
  printf '\nThese stale UI files can hide new Awtarchy controls even when the update succeeds.\n' >&2
  printf 'Your personalized hyprland.lua is NOT part of this repair.\n\n' >&2

  if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty || ! -w /dev/tty ]]; then
    printf 'WARN: No interactive terminal is available; keeping all local Quickshell UI files unchanged.\n' >&2
    return 0
  fi

  printf '  1. Keep my modified UI code and skip these Awtarchy UI updates\n' >/dev/tty
  printf '  2. Update to current Awtarchy UI files and create backups (recommended)\n' >/dev/tty
  printf '  3. Review each file individually\n' >/dev/tty
  printf 'Choose [2]: ' >/dev/tty
  IFS= read -r choice </dev/tty || choice=2
  [[ -n $choice ]] || choice=2

  case "$choice" in
    2)
      for rel in "${differences[@]}"; do
        replace_quickshell_ui_from_baseline "$rel" "$baseline_root" "$stamp"
        replaced=1
      done
      ;;
    3)
      for rel in "${differences[@]}"; do
        printf '\n%s\n' "$rel" >/dev/tty
        printf '  1. Keep local\n' >/dev/tty
        printf '  2. Use current Awtarchy version and create backup\n' >/dev/tty
        printf 'Choose [1]: ' >/dev/tty
        IFS= read -r per_file </dev/tty || per_file=1
        if [[ "$per_file" == 2 ]]; then
          replace_quickshell_ui_from_baseline "$rel" "$baseline_root" "$stamp"
          replaced=1
        fi
      done
      ;;
    *)
      printf 'Kept modified local Quickshell UI code; current Awtarchy UI updates were skipped.\n'
      return 0
      ;;
  esac

  if (( replaced == 1 )); then
    manager="${TARGET_HOME}/.config/hypr/scripts/quickshell.sh"
    if [[ -f "$manager" && ! -L "$manager" ]]; then
      if ! AWTARCHY_REPORT_FAILURE_STAGE=restart_after_update bash "$manager" restart; then
        printf 'WARN: Quickshell UI files were updated, but Quickshell could not be restarted automatically.\n' >&2
      fi
    fi
  fi
}

clear_screen() {
  if have clear; then
    clear >/dev/tty 2>/dev/null || clear
  else
    printf '\033[H\033[2J' >/dev/tty 2>/dev/null || printf '\033[H\033[2J'
  fi
}

read_key() {
  local key="" rest=""
  IFS= read -rsn1 key </dev/tty || return 1
  if [[ $key == $'\033' ]]; then
    IFS= read -rsn2 -t 0.05 rest </dev/tty || true
    key+="$rest"
  fi
  printf '%s' "$key"
}

single_select_menu() {
  local title="$1" default_index="$2"
  shift 2
  local -a items=("$@")
  local index="$default_index" key="" i

  while true; do
    clear_screen
    printf '%s\n\n' "$title" >/dev/tty
    for i in "${!items[@]}"; do
      if (( i == index )); then
        printf '  > %s\n' "${items[i]}" >/dev/tty
      else
        printf '    %s\n' "${items[i]}" >/dev/tty
      fi
    done
    printf '\nUp/Down = move, Enter = select, q = quit\n' >/dev/tty
    key="$(read_key || true)"
    case "$key" in
      $'\033[A')
        if (( index > 0 )); then
          ((index--)) || true
        fi
        ;;
      $'\033[B')
        if (( index + 1 < ${#items[@]} )); then
          ((index++)) || true
        fi
        ;;
      $'\n'|$'\r'|"") printf '%s\n' "$index"; return 0 ;;
      q|Q) return 1 ;;
    esac
  done
}

pause_menu() {
  printf '\nPress any key to continue...' >/dev/tty
  read_key >/dev/null || true
}

reject_stable_testing_overrides() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --testing-branch|--testing-branch=*|--testing-commit|--testing-commit=*)
        die "Git testing must use awtarchy git with a selected remote branch."
        ;;
    esac
  done
}

run_git_operation() {
  local action="$1" branch="$2" revision="$3"
  shift 3
  local arg
  local -a runtime_args=(update-reset-backup)

  for arg in "$@"; do
    case "$arg" in
      --tag|--tag=*|--testing-branch|--testing-branch=*|--testing-commit|--testing-commit=*|--mode|--mode=*|--review-only)
        die "${arg%%=*} is selected by awtarchy git ${action}."
        ;;
    esac
  done

  case "$action" in
    review)
      runtime_args+=(--mode preserve --review-only)
      ;;
    update)
      runtime_args+=(--mode preserve)
      ;;
    reset)
      runtime_args+=(--mode clean)
      ;;
    *)
      die "Unknown git-testing action: ${action}"
      ;;
  esac
  runtime_args+=(--testing-branch "$branch" --testing-commit "$revision")
  runtime_args+=("$@")

  printf 'Selected remote branch: %s\n' "$branch"
  printf 'Exact revision: %s\n' "$revision"
  printf 'Git testing action: %s\n' "$action"
  run_git_revision_runtime "$branch" "$revision" "${runtime_args[@]}"
  if [[ "$action" == update ]]; then
    reconcile_quickshell_ui_after_update
  fi
}

git_cli() {
  local action="${1:-}" branch="" requested_commit="" branch_head="" revision=""
  local -a runtime_options=()
  [[ -n $action ]] || die "awtarchy git requires review, update, or reset in noninteractive use."
  case "$action" in
    review|update|reset) shift ;;
    *) die "Unknown git-testing action: ${action}. Use review, update, or reset." ;;
  esac

  while (( $# > 0 )); do
    case "$1" in
      --branch)
        shift
        (( $# > 0 )) || die "--branch requires a remote branch name."
        branch="$1"
        ;;
      --branch=*)
        branch="${1#*=}"
        ;;
      --commit)
        shift
        (( $# > 0 )) || die "--commit requires a full 40-character commit SHA."
        requested_commit="$1"
        ;;
      --commit=*)
        requested_commit="${1#*=}"
        ;;
      *)
        runtime_options+=("$1")
        ;;
    esac
    shift
  done

  [[ -n $branch ]] || die "Git testing requires --branch so the remote source is explicit."
  [[ $branch != *$'\n'* && $branch != *$'\r'* && $branch != *$'\t'* ]] \
    || die "Remote branch name contains unsupported control characters."
  if [[ -n $requested_commit ]]; then
    [[ $requested_commit =~ ^[0-9a-fA-F]{40}$ ]] \
      || die "--commit requires a full 40-character commit SHA."
    requested_commit="${requested_commit,,}"
  fi

  branch_head="$(remote_git_branch_head "$branch")" \
    || die "Could not resolve remote Awtarchy branch: ${branch}"
  if [[ -n $requested_commit ]]; then
    git_commit_belongs_to_branch "$requested_commit" "$branch_head" \
      || die "Commit ${requested_commit} does not belong to selected branch ${branch}."
    revision="$requested_commit"
  else
    revision="$branch_head"
  fi

  run_git_operation "$action" "$branch" "$revision" "${runtime_options[@]}"
}

git_menu() {
  [[ -t 0 && -t 1 && -r /dev/tty && -w /dev/tty ]] \
    || die "The Awtarchy Git testing menu requires an interactive terminal."

  local branch_output="" choice="" branch="" revision="" action=""
  local -a branches=()
  branch_output="$(remote_git_branches)" \
    || die "Could not retrieve remote Awtarchy branches."
  mapfile -t branches <<<"$branch_output"
  (( ${#branches[@]} > 0 )) || die "No remote Awtarchy branches were returned."

  choice="$(single_select_menu "Awtarchy Git Testing: Select Remote Branch" 0 \
    "${branches[@]}")" || return 0
  branch="${branches[choice]}"
  revision="$(remote_git_branch_head "$branch")" \
    || die "Could not resolve remote Awtarchy branch: ${branch}"

  printf 'Selected remote branch: %s\n' "$branch"
  printf 'Exact revision: %s\n' "$revision"
  choice="$(single_select_menu \
    "Git Testing: ${branch}@${revision}" 0 \
    "Review changes without applying" \
    "Update and preserve personal modifications" \
    "Reset managed configs to Git defaults" \
    "Cancel")" || return 0
  case "$choice" in
    0) action=review ;;
    1) action=update ;;
    2) action=reset ;;
    *) return 0 ;;
  esac
  run_git_operation "$action" "$branch" "$revision"
}

maintenance_menu() {
  [[ -t 0 && -t 1 && -r /dev/tty && -w /dev/tty ]] || die "The Awtarchy menu requires an interactive terminal."

  local choice rc
  while true; do
    choice="$(single_select_menu "Awtarchy Maintenance" 0 \
      "Refresh Awtarchy updater from main" \
      "Update configs (preserve Hyprland customizations)" \
      "Reset configs (clean-slate managed files)" \
      "Reconcile packages (install current / remove replaced)" \
      "Review config changes without applying" \
      "Clean Awtarchy backup files" \
      "Version information" \
      "Exit")" || exit 0

    case "$choice" in
      0)
        self_update_safely
        exec "${TARGET_HOME}/.local/bin/awtarchy"
        ;;
      1)
        protect_git_state_before_updater_refresh
        ensure_latest_updater update
        offer_package_reconciliation_before_update || rc=$?
        if [[ -z ${rc:-} ]] && config_release_ready_or_noop; then
          run_runtime update-reset-backup --mode preserve || rc=$?
          if [[ -z ${rc:-} ]]; then
            reconcile_quickshell_ui_after_update
          fi
        fi
        pause_menu
        [[ -z ${rc:-} ]] || return "$rc"
        ;;
      2)
        protect_git_state_before_updater_refresh
        ensure_latest_updater reset
        if config_release_ready_or_noop; then
          run_runtime update-reset-backup --mode clean || rc=$?
        fi
        pause_menu
        [[ -z ${rc:-} ]] || return "$rc"
        ;;
      3)
        ensure_latest_updater packages
        clear_screen
        run_package_reconciler || rc=$?
        pause_menu
        [[ -z ${rc:-} ]] || return "$rc"
        ;;
      4)
        protect_git_state_before_updater_refresh
        ensure_latest_updater review
        if config_release_ready_or_noop; then
          run_runtime update-reset-backup --mode preserve --review-only || rc=$?
        fi
        pause_menu
        [[ -z ${rc:-} ]] || return "$rc"
        ;;
      5)
        run_runtime clean-backups || rc=$?
        pause_menu
        [[ -z ${rc:-} ]] || return "$rc"
        ;;
      6)
        clear_screen
        print_version_status >/dev/tty
        pause_menu
        ;;
      *) exit 0 ;;
    esac
    unset rc
  done
}

usage() {
  cat <<'EOF'
Usage:
  awtarchy
  awtarchy update [--tag <tag>] [update options]
  awtarchy reset [--tag <tag>] [update options]
  awtarchy packages [--review]
  awtarchy review [--tag <tag>]
  awtarchy report
  awtarchy git
  awtarchy git review --branch <branch> [--commit <40-character-sha>]
  awtarchy git update --branch <branch> [--commit <40-character-sha>] [update options]
  awtarchy git reset --branch <branch> [--commit <40-character-sha>] [update options]
  awtarchy clean-backups [options]
  awtarchy troubleshoot
  awtarchy version
  awtarchy check-update
  awtarchy self-update
  awtarchy help

The updater always refreshes from the current `main` branch head.
Managed configs update only from the latest published release or an exact
published release selected with --tag.

Package reconciliation uses the current installed Awtarchy package catalogs.
It can install missing current dependencies and selected catalog items, and it
can remove explicitly retired/replaced packages. Retired package removal is
preselected only when Awtarchy recorded ownership of that package.

Git testing is explicit. The selected Awtarchy remote branch is resolved to an
exact revision, and an exact --commit is accepted only when it belongs to that
branch. After a Quickshell-capable release is published, run awtarchy update to
return configs to the published release stream.

Installation is handled only by awtarchy-install.sh.
EOF
}

main() {
  drop_launcher_privileges "$@"
  init_target

  case "${1:-}" in
    troubleshoot)
      shift
      (( $# == 0 )) || die "troubleshoot does not accept options."
      require_runtime
      AWTARCHY_TROUBLESHOOT_COMMAND=awtarchy exec bash "$RUNTIME" troubleshoot
      ;;
    report)
      shift
      (( $# == 0 )) || die "report does not accept options."
      run_failure_reports
      return 0
      ;;
    version)
      print_version_status
      return 0
      ;;
    check-update)
      print_version_status
      local installed remote=""
      installed="$(installed_updater_commit)"
      remote="$(updater_branch_head 2>/dev/null || true)"
      if [[ -n $remote && $installed != "$remote" ]]; then
        return 10
      fi
      return 0
      ;;
    help|-h|--help)
      usage
      return 0
      ;;
  esac

  cleanup_legacy_quickshell_command
  ensure_vpn_directory

  case "${1:-}" in
    self-update)
      shift
      (( $# == 0 )) || die "self-update does not accept options; the updater source is always ${UPDATER_BRANCH}."
      self_update_safely
      ;;
    packages)
      ensure_latest_updater "$@"
      shift
      run_package_reconciler "$@"
      ;;
    update)
      reject_stable_testing_overrides "$@"
      protect_git_state_before_updater_refresh "$@"
      ensure_latest_updater "$@"
      shift
      offer_package_reconciliation_before_update "$@"
      config_release_ready_or_noop "$@" || return 0
      run_runtime update-reset-backup --mode preserve "$@"
      reconcile_quickshell_ui_after_update
      ;;
    reset)
      reject_stable_testing_overrides "$@"
      protect_git_state_before_updater_refresh "$@"
      ensure_latest_updater "$@"
      shift
      config_release_ready_or_noop "$@" || return 0
      exec_runtime update-reset-backup --mode clean "$@"
      ;;
    review)
      reject_stable_testing_overrides "$@"
      protect_git_state_before_updater_refresh "$@"
      ensure_latest_updater "$@"
      shift
      config_release_ready_or_noop "$@" || return 0
      exec_runtime update-reset-backup --mode preserve --review-only "$@"
      ;;
    clean-backups|update-backup-cleaner|backup-cleaner)
      shift
      exec_runtime clean-backups "$@"
      ;;
    update-reset-backup)
      reject_stable_testing_overrides "$@"
      protect_git_state_before_updater_refresh "$@"
      ensure_latest_updater "$@"
      shift
      config_release_ready_or_noop "$@" || return 0
      exec_runtime update-reset-backup "$@"
      ;;
    git)
      ensure_latest_updater "$@"
      shift
      if (( $# == 0 )); then
        git_menu
      else
        git_cli "$@"
      fi
      ;;
    install|dry-run|dryrun|test)
      die "Installation is handled by awtarchy-install.sh, not the awtarchy maintenance command."
      ;;
    "")
      local report_helper="${TARGET_HOME}/.config/hypr/scripts/awtarchy_report_failure.sh"
      if [[ -f "$report_helper" && ! -L "$report_helper" && -O "$report_helper" ]]; then
        bash "$report_helper" prompt-pending || true
      fi
      maintenance_menu
      ;;
    *)
      die "Unknown command: $1"
      ;;
  esac
}

main "$@"