run_scene() {
    local id="$1" index
    index="$(scene_index "$id")"
    printf '\n%s%sSCENE%s  %s — %s\n' \
        "$C_BOLD" "$C_GREEN" "$C_RESET" "$id" "${SCENE_LABELS[$index]}"
    case "$id" in
        intro) scene_intro ;;
        bar) scene_bar ;;
        launcher) scene_launcher ;;
        quicksettings) scene_quicksettings ;;
        connectivity) scene_connectivity ;;
        clipboard_notifications) scene_clipboard_notifications ;;
        personalize) scene_personalize ;;
        windows) scene_windows ;;
        shaders) scene_shaders ;;
        power) scene_power ;;
        outro) scene_outro ;;
        *) die "unknown scene: $id" ;;
    esac
    printf '%sready:%s scene complete; hold the shot, then continue when you want.\n' "$C_GREEN" "$C_RESET"
}

monitor_exists() {
    hyprctl monitors -j 2>/dev/null \
        | jq -e --arg monitor "$1" '.[] | select((.disabled // false) == false and .name == $monitor)' \
            >/dev/null 2>&1
}

save_profile() {
    umask 077
    mkdir -p -- "$(dirname -- "$PROFILE_FILE")"
    printf 'monitor\t%s\n' "$MONITOR" >"$PROFILE_FILE"
}

load_profile_monitor() {
    [[ -r "$PROFILE_FILE" ]] || return 1
    awk -F '\t' '$1 == "monitor" { print substr($0, index($0, "\t") + 1); exit }' "$PROFILE_FILE"
}

choose_monitor() {
    local saved count index selected
    local -a monitors=()
    mapfile -t monitors < <(hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select((.disabled // false) == false) | .name')
    ((${#monitors[@]} > 0)) || die "Hyprland reports no active displays"

    if [[ -n "$MONITOR_OVERRIDE" ]]; then
        monitor_exists "$MONITOR_OVERRIDE" || die "display not found: $MONITOR_OVERRIDE"
        MONITOR="$MONITOR_OVERRIDE"
        save_profile
        return
    fi

    saved="$(load_profile_monitor || true)"
    if [[ -n "$saved" ]] && monitor_exists "$saved"; then
        MONITOR="$saved"
        return
    fi

    count=${#monitors[@]}
    if (( count == 1 )); then
        MONITOR=${monitors[0]}
        save_profile
        return
    fi

    printf '%sChoose the display being recorded:%s\n' "$C_BOLD" "$C_RESET"
    hyprctl monitors -j | jq -r '
        [.[] | select((.disabled // false) == false)]
        | to_entries[]
        | "  \(.key + 1)) \(.value.name) — \(.value.description // "display") — \(.value.width)x\(.value.height) @ \(.value.scale)x"
    '
    while true; do
        read -r -p "Display [1-${count}]: " index
        [[ "$index" =~ ^[0-9]+$ ]] || continue
        (( index >= 1 && index <= count )) || continue
        selected=$((index - 1))
        MONITOR=${monitors[$selected]}
        break
    done
    save_profile
}

load_monitor_geometry() {
    local geometry
    geometry="$(hyprctl monitors -j 2>/dev/null | jq -r --arg monitor "$MONITOR" '
        .[] | select(.name == $monitor)
        | def rotated: (((.transform // 0) % 2) == 1);
          [
            (.x | round),
            (.y | round),
            ((if rotated then .height else .width end) / (.scale // 1) | round),
            ((if rotated then .width else .height end) / (.scale // 1) | round)
          ] | @tsv
    ' | head -n1)"
    [[ -n "$geometry" ]] || die "could not read geometry for $MONITOR"
    IFS=$'\t' read -r MON_X MON_Y MON_W MON_H <<<"$geometry"
}

doctor_internal() {
    local failed=0 command path current_x current_y
    local -a commands=(hyprctl jq qs ydotool timeout awk flock)
    [[ "$NARRATION_MODE" == robot ]] && commands+=(espeak-ng)

    for command in "${commands[@]}"; do
        if have "$command"; then
            printf '  %sok%s  %s\n' "$C_GREEN" "$C_RESET" "$command"
        else
            printf '  %smissing%s  %s\n' "$C_RED" "$C_RESET" "$command"
            failed=1
        fi
    done

    for path in "$QUICKSHELL_MANAGER" "$APPLICATION_STATE" "$RUNTIME_RULES" "$TERMINAL_HELPER"; do
        if [[ -x "$path" ]]; then
            printf '  %sok%s  %s\n' "$C_GREEN" "$C_RESET" "$path"
        else
            printf '  %smissing%s  %s\n' "$C_RED" "$C_RESET" "$path"
            failed=1
        fi
    done

    if (( failed == 0 )); then
        if [[ "$(ipc_value control ping)" == ok ]]; then
            printf '  %sok%s  Awtarchy Quickshell IPC\n' "$C_GREEN" "$C_RESET"
        else
            printf '  %snot ready%s  Awtarchy Quickshell IPC\n' "$C_RED" "$C_RESET"
            failed=1
        fi
    fi

    if (( failed == 0 )); then
        IFS=$'\t' read -r current_x current_y < <(cursor_position)
        if move_cursor_native "$current_x" "$current_y" \
            && ydotool mousemove -x 0 -y 0 >/dev/null 2>&1; then
            printf '  %sok%s  ydotool daemon connection\n' "$C_GREEN" "$C_RESET"
        else
            printf '  %snot ready%s  ydotool daemon connection\n' "$C_RED" "$C_RESET"
            failed=1
        fi
    fi

    if have awtwall; then
        printf '  %soptional%s  awtwall visual enabled\n' "$C_GREEN" "$C_RESET"
    else
        printf '  %sskipped%s  awtwall visual (optional)\n' "$C_YELLOW" "$C_RESET"
    fi

    (( failed == 0 )) || return 1
}

doctor() {
    resolve_support_paths
    printf '%sAwtarchy presentation preflight%s\n' "$C_BOLD" "$C_RESET"
    if doctor_internal; then
        printf '\n%sReady to record.%s\n' "$C_GREEN" "$C_RESET"
    else
        printf '\nInstall/start the missing requirements, then run doctor again.\n' >&2
        return 1
    fi
}

setup_profile() {
    resolve_support_paths
    have hyprctl || die "hyprctl is required"
    have jq || die "jq is required"
    choose_monitor
    load_monitor_geometry
    printf '%sSaved recorded display:%s %s (%sx%s at %s,%s)\n' \
        "$C_GREEN" "$C_RESET" "$MONITOR" "$MON_W" "$MON_H" "$MON_X" "$MON_Y"
}

snapshot_state() {
    local option surface key
    ORIGINAL_FOCUSED_MONITOR="$(hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select(.focused == true) | .name' | head -n1)"
    IFS=$'\t' read -r ORIGINAL_CURSOR_X ORIGINAL_CURSOR_Y < <(cursor_position)
    ORIGINAL_WORKSPACE_ID="$(hyprctl monitors -j 2>/dev/null \
        | jq -r --arg monitor "$MONITOR" '.[] | select(.name == $monitor) | .activeWorkspace.id' \
        | head -n1)"
    ORIGINAL_BAR_POS="$(current_bar_position)"

    option="$(hyprctl getoption decoration:screen_shader -j 2>/dev/null || true)"
    if [[ -n "$option" ]]; then
        ORIGINAL_SHADER="$(jq -r '.str // empty' <<<"$option" 2>/dev/null || true)"
        [[ "$ORIGINAL_SHADER" == "[none]" ]] && ORIGINAL_SHADER=""
        SHADER_SNAPSHOT_VALID=1
    fi

    "$QUICKSHELL_MANAGER" dump-state >/dev/null 2>&1 || true
    for surface in launcher clipboard notifications quick-settings network bluetooth battery; do
        key=${surface//-/_}
        ORIGINAL_CAPTURE[$surface]="$(jq -r --arg key "$key" \
            '((.capture_allowed // {})[$key] == true)' "$QUICKSHELL_STATE" 2>/dev/null || printf false)"
    done
    ORIGINAL_DND="$(ipc_value notifications dndEnabled)"
    [[ "$ORIGINAL_DND" == true ]] || ORIGINAL_DND=false
    STATE_SNAPSHOTTED=1
}

enable_presentation_capture() {
    local surface
    printf '%srecording mode:%s temporarily making presentation flyouts capture-visible\n' \
        "$C_YELLOW" "$C_RESET"
    CAPTURE_CHANGED=1
    for surface in launcher clipboard notifications quick-settings network bluetooth battery; do
        "$APPLICATION_STATE" set-capture "$surface" true >/dev/null 2>&1
    done
    "$RUNTIME_RULES" >/dev/null 2>&1 || true
    ipc barstate refresh || true
    pause 0.5
}

restore_capture() {
    local surface
    (( CAPTURE_CHANGED == 1 )) || return 0
    for surface in launcher clipboard notifications quick-settings network bluetooth battery; do
        "$APPLICATION_STATE" set-capture "$surface" "${ORIGINAL_CAPTURE[$surface]:-false}" \
            >/dev/null 2>&1 || true
    done
    "$RUNTIME_RULES" >/dev/null 2>&1 || true
    ipc barstate refresh || true
    CAPTURE_CHANGED=0
}

bind_conflicts() {
    hyprctl binds -j 2>/dev/null | jq -e --arg key "$CONTROL_KEY" '
        .[] | select(((.key // "") | ascii_upcase) == ($key | ascii_upcase))
    ' >/dev/null 2>&1
}

install_one_control() {
    local bind="$1" action="$2" command command_lua
    printf -v command '%q __control %q' "$SCRIPT_PATH" "$action"
    command_lua="$(lua_quote "$command")"
    hyprctl eval "hl.bind(\"${bind}\", hl.dsp.exec_cmd(${command_lua}), {})" >/dev/null
}

install_controls() {
    if bind_conflicts; then
        die "$CONTROL_KEY already has a Hyprland binding; rerun with --key F9 (or another unused key)"
    fi
    CONTROLS_INSTALLED=1
    install_one_control "SUPER + $CONTROL_KEY" next
    install_one_control "SUPER + SHIFT + $CONTROL_KEY" replay
    install_one_control "SUPER + CTRL + $CONTROL_KEY" previous
    install_one_control "SUPER + ALT + $CONTROL_KEY" quit
}

remove_controls() {
    (( CONTROLS_INSTALLED == 1 )) || return 0
    hyprctl eval "
        hl.unbind(\"SUPER + ${CONTROL_KEY}\")
        hl.unbind(\"SUPER + SHIFT + ${CONTROL_KEY}\")
        hl.unbind(\"SUPER + CTRL + ${CONTROL_KEY}\")
        hl.unbind(\"SUPER + ALT + ${CONTROL_KEY}\")
    " >/dev/null 2>&1 || true
    CONTROLS_INSTALLED=0
}

control_command() {
    local action="${1:-}"
    case "$action" in next|replay|previous|quit) ;; *) return 2 ;; esac
    [[ -p "$CONTROL_FIFO" ]] || return 1
    timeout 1 bash -c 'printf "%s\n" "$1" >"$2"' _ "$action" "$CONTROL_FIFO"
}

wait_command() {
    local command key
    CONTROL_COMMAND=""
    printf '\n%sWAITING%s  SUPER+%s next · SHIFT replay · CTRL previous · ALT stop\n' \
        "$C_BOLD$C_YELLOW" "$C_RESET" "$CONTROL_KEY"
    while [[ -z "$CONTROL_COMMAND" ]]; do
        if IFS= read -r -t 0.10 command <&9; then
            case "$command" in
                next|replay|previous|quit) CONTROL_COMMAND="$command" ;;
            esac
        fi
        if IFS= read -rsn1 -t 0.01 key; then
            case "$key" in
                ""|$'\n'|$'\r') CONTROL_COMMAND=next ;;
                r|R) CONTROL_COMMAND=replay ;;
                p|P) CONTROL_COMMAND=previous ;;
                q|Q) CONTROL_COMMAND=quit ;;
            esac
        fi
    done
}

signal_exit() {
    local status="$1"
    trap - EXIT INT TERM HUP
    restore_state
    exit "$status"
}

restore_state() {
    local address marker
    (( RESTORE_STARTED == 0 )) || return 0
    RESTORE_STARTED=1
    trap - EXIT INT TERM HUP

    [[ -z "$VOICE_PID" ]] || kill "$VOICE_PID" 2>/dev/null || true
    [[ -z "$DEMO_PID" ]] || kill "$DEMO_PID" 2>/dev/null || true

    close_surfaces || true
    for marker in "${OWNED_MARKERS[@]}"; do
        rm -f -- "$marker"
    done
    for address in "${OWNED_ADDRESSES[@]}"; do
        [[ -n "$address" ]] || continue
        hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
    done
    if (( STATE_SNAPSHOTTED == 1 )); then
        restore_shader
        [[ -z "$ORIGINAL_BAR_POS" ]] \
            || "$QUICKSHELL_MANAGER" setpos "$MONITOR" "$ORIGINAL_BAR_POS" >/dev/null 2>&1 \
            || true
        ipc barstate refresh || true
        restore_capture
        if [[ "$ORIGINAL_DND" == true ]]; then
            ipc notifications disable || true
        else
            ipc notifications enable || true
        fi
        if [[ -n "$ORIGINAL_WORKSPACE_ID" ]]; then
            focus_recorded_monitor
            hyprctl dispatch workspace "$ORIGINAL_WORKSPACE_ID" >/dev/null 2>&1 || true
        fi
        [[ -z "$ORIGINAL_FOCUSED_MONITOR" ]] \
            || hyprctl dispatch focusmonitor "$ORIGINAL_FOCUSED_MONITOR" >/dev/null 2>&1 \
            || true
        if [[ -n "$ORIGINAL_CURSOR_X" && -n "$ORIGINAL_CURSOR_Y" ]]; then
            move_cursor_native "$ORIGINAL_CURSOR_X" "$ORIGINAL_CURSOR_Y" || true
        fi
    fi

    remove_controls
    rm -f -- "$CONTROL_FIFO"
    rm -f -- "$RUNTIME_DIR/session.lock"
    rmdir -- "$RUNTIME_DIR" 2>/dev/null || true
    printf '\n%srestored:%s shader, bar edge, capture privacy, DND, workspace, focus, and cursor\n' \
        "$C_GREEN" "$C_RESET"
}

dashboard() {
    clear 2>/dev/null || true
    printf '%s%s' "$C_BOLD$C_CYAN" "$TITLE_LINE"
    printf '%s\n' "$C_RESET"
    printf '%sRecorded display:%s %s (%sx%s)\n' "$C_DIM" "$C_RESET" "$MONITOR" "$MON_W" "$MON_H"
    printf '%sNarration:%s %s · voice %s · %s WPM · pace %sx\n' \
        "$C_DIM" "$C_RESET" "$NARRATION_MODE" "$VOICE" "$VOICE_RATE" "$PACE"
    printf '%sControls:%s SUPER+%s next · SHIFT replay · CTRL previous · ALT stop\n\n' \
        "$C_DIM" "$C_RESET" "$CONTROL_KEY"
    list_scenes
}

print_dry_run() {
    printf '%s%s%s\n\n' "$C_BOLD$C_CYAN" "$TITLE_LINE" "$C_RESET"
    list_scenes
    if [[ "$NARRATION_MODE" == robot ]]; then
        printf '\nNarration: robot (%s at %s WPM)\n' "$VOICE" "$VOICE_RATE"
    else
        printf '\nNarration: silent\n'
    fi
    printf 'Desktop state changes: capture visibility, bar edge, workspace, and shaders; all restored on exit.\n'
}

run_presentation() {
    local start_index end_index last_run target
    resolve_support_paths
    validate_number "$PACE" pace
    [[ "$VOICE_RATE" =~ ^[0-9]+$ ]] || die "rate must be an integer"
    [[ "$MOVE_FPS" =~ ^[0-9]+$ ]] || die "FPS must be an integer"
    [[ "$CONTROL_KEY" =~ ^[A-Za-z0-9]+$ ]] || die "key must contain only letters and numbers"
    awk -v pace="$PACE" 'BEGIN { exit !(pace > 0 && pace <= 4) }' \
        || die "pace must be greater than zero and no more than 4"
    (( MOVE_FPS >= 12 && MOVE_FPS <= 120 )) || die "FPS must be 12-120"
    case "$NARRATION_MODE" in robot|silent) ;; *) die "narration must be robot or silent" ;; esac

    if (( DRY_RUN == 1 )); then
        print_dry_run
        return 0
    fi

    doctor_internal || die "presentation preflight failed; run: tests/presentation doctor"
    choose_monitor
    load_monitor_geometry

    start_index="$(scene_index "$START_SCENE")" || die "unknown scene: $START_SCENE"
    end_index=$((${#SCENE_IDS[@]} - 1))
    if [[ -n "$ONLY_SCENE" ]]; then
        start_index="$(scene_index "$ONLY_SCENE")" || die "unknown scene: $ONLY_SCENE"
        end_index=$start_index
    fi

    umask 077
    if [[ -e "$RUNTIME_DIR" || -L "$RUNTIME_DIR" ]]; then
        [[ -d "$RUNTIME_DIR" && ! -L "$RUNTIME_DIR" && -O "$RUNTIME_DIR" ]] \
            || die "unsafe presentation runtime path: $RUNTIME_DIR"
    else
        mkdir -m 700 -- "$RUNTIME_DIR"
    fi
    chmod 700 -- "$RUNTIME_DIR"
    [[ ! -L "$RUNTIME_DIR/session.lock" ]] || die "unsafe presentation lock path"
    exec 7>"$RUNTIME_DIR/session.lock"
    flock -n 7 || die "another Awtarchy presentation is already running"
    rm -f -- "$CONTROL_FIFO"
    mkfifo -m 600 "$CONTROL_FIFO"
    exec 9<>"$CONTROL_FIFO"

    trap restore_state EXIT
    trap 'signal_exit 130' INT
    trap 'signal_exit 143' TERM
    trap 'signal_exit 129' HUP
    snapshot_state
    focus_recorded_monitor
    enable_presentation_capture
    install_controls
    dashboard

    last_run=$((start_index - 1))
    while true; do
        wait_command
        case "$CONTROL_COMMAND" in
            quit) break ;;
            next)
                target=$((last_run + 1))
                (( target <= end_index )) || break
                ;;
            replay)
                if (( last_run < start_index )); then target=$start_index; else target=$last_run; fi
                ;;
            previous)
                target=$((last_run - 1))
                (( target < start_index )) && target=$start_index
                ;;
            *) continue ;;
        esac
        run_scene "${SCENE_IDS[$target]}"
        last_run=$target
    done
}

center_text() {
    local text="$1" columns padding
    columns="$(tput cols 2>/dev/null || printf 120)"
    padding=$(((columns - ${#text}) / 2))
    (( padding < 0 )) && padding=0
    printf '%*s%s\n' "$padding" "" "$text"
}

card_process() {
    local kind="$1" marker="$2" lines rows top i
    trap 'printf "\033[?25h\033[0m"' EXIT INT TERM
    printf '\033[2J\033[H\033[?25l'
    rows="$(tput lines 2>/dev/null || printf 30)"
    lines=13
    top=$(((rows - lines) / 2))
    (( top < 1 )) && top=1
    for ((i = 0; i < top; i++)); do printf '\n'; done

    printf '\033[1;38;5;45m'
    center_text '    _             _                     _'
    center_text '   / \__      __ | |_ __ _ _ __ ___| |__  _   _'
    center_text '  / _ \ \ /\ / / | __/ _` | `__/ __| `_ \| | | |'
    center_text ' / ___ \ V  V /  | || (_| | | | (__| | | | |_| |'
    center_text '/_/   \_\_/\_/    \__\__,_|_|  \___|_| |_|\__, |'
    center_text '                                            |___/'
    printf '\033[0m\n'
    if [[ "$kind" == intro ]]; then
        printf '\033[1;38;5;84m'
        center_text "$TITLE_LINE"
        printf '\033[0;38;5;250m'
        center_text 'ARCH LINUX · HYPRLAND · QUICKSHELL'
    else
        printf '\033[1;38;5;84m'
        center_text 'YOUR ARCH. YOUR RULES.'
        printf '\033[0;38;5;250m'
        center_text 'LIGHTWEIGHT · TRANSPARENT · YOURS'
    fi
    printf '\033[0m'
    while [[ -e "$marker" ]]; do sleep 0.20; done
}

demo_process() {
    local title="$1" marker="$2" color="$3" rows top i
    trap 'printf "\033[?25h\033[0m"' EXIT INT TERM
    printf '\033[2J\033[H\033[?25l'
    rows="$(tput lines 2>/dev/null || printf 24)"
    top=$((rows / 2 - 3))
    (( top < 1 )) && top=1
    for ((i = 0; i < top; i++)); do printf '\n'; done
    printf '\033[1;38;5;%sm' "$color"
    center_text '┌────────────────────────┐'
    center_text "$title"
    center_text '└────────────────────────┘'
    printf '\033[0;38;5;245m'
    center_text 'AWTARCHY WORKSPACE'
    printf '\033[0m'
    while [[ -e "$marker" ]]; do sleep 0.20; done
}

self_test() {
    local missing=0 name i function_name
    local -a required=(
        move_cursor_native smooth_move speak scene_intro scene_bar scene_launcher
        scene_quicksettings scene_connectivity scene_clipboard_notifications
        scene_personalize scene_windows scene_shaders scene_power scene_outro
        install_controls restore_state
    )

    for name in "${required[@]}"; do
        if ! declare -F "$name" >/dev/null; then
            printf 'FAIL: presentation contract is missing %s\n' "$name" >&2
            missing=1
        fi
    done
    (( missing == 0 )) || return 1
    [[ "$TITLE_LINE" == "Awtarchy Quickshell Update" ]] \
        || { printf 'FAIL: opening title changed\n' >&2; return 1; }
    [[ "$(interpolate 10 90 0 40)" == 10 ]] \
        || { printf 'FAIL: easing start is not stable\n' >&2; return 1; }
    [[ "$(interpolate 10 90 40 40)" == 90 ]] \
        || { printf 'FAIL: easing end is not stable\n' >&2; return 1; }
    ((${#SCENE_IDS[@]} == ${#SCENE_LABELS[@]})) \
        || { printf 'FAIL: scene labels do not align\n' >&2; return 1; }
    for i in "${!SCENE_IDS[@]}"; do
        function_name="scene_${SCENE_IDS[$i]}"
        declare -F "$function_name" >/dev/null \
            || { printf 'FAIL: missing scene function %s\n' "$function_name" >&2; return 1; }
    done
    printf '%s\n' 'PASS: presentation contract, easing, title, and scene map'
}

main() {
    local command="${1:-run}"
    case "$command" in
        run|setup|doctor|list-scenes|self-test|help|-h|--help|__control|__card|__demo)
            shift || true
            ;;
        --*) command=run ;;
        *) die "unknown command: $command" ;;
    esac

    case "$command" in
        __control) control_command "${1:-}" ;;
        __card) card_process "${1:?card kind required}" "${2:?marker required}" ;;
        __demo) demo_process "${1:?title required}" "${2:?marker required}" "${3:-45}" ;;
        list-scenes) list_scenes ;;
        self-test) self_test ;;
        help|-h|--help) usage ;;
        setup)
            while (($#)); do
                case "$1" in
                    --monitor) MONITOR_OVERRIDE="${2:?--monitor requires a name}"; shift 2 ;;
                    *) die "unknown setup option: $1" ;;
                esac
            done
            setup_profile
            ;;
        doctor)
            while (($#)); do
                case "$1" in
                    --silent) NARRATION_MODE=silent; shift ;;
                    *) die "unknown doctor option: $1" ;;
                esac
            done
            doctor
            ;;
        run)
            while (($#)); do
                case "$1" in
                    --monitor) MONITOR_OVERRIDE="${2:?--monitor requires a name}"; shift 2 ;;
                    --from) START_SCENE="${2:?--from requires a scene}"; shift 2 ;;
                    --scene) ONLY_SCENE="${2:?--scene requires a scene}"; shift 2 ;;
                    --key) CONTROL_KEY="${2:?--key requires a key}"; shift 2 ;;
                    --voice) VOICE="${2:?--voice requires a name}"; shift 2 ;;
                    --rate) VOICE_RATE="${2:?--rate requires WPM}"; shift 2 ;;
                    --pace) PACE="${2:?--pace requires a factor}"; shift 2 ;;
                    --silent) NARRATION_MODE=silent; shift ;;
                    --dry-run) DRY_RUN=1; shift ;;
                    -h|--help) usage; return 0 ;;
                    *) die "unknown run option: $1" ;;
                esac
            done
            run_presentation
            ;;
    esac
}

main "$@"
