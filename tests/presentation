#!/usr/bin/env bash
# A self-paced, narrated Awtarchy showcase for screen recording.
# Runtime-only presentation changes are restored when the script exits.

set -Eeuo pipefail
export LC_ALL=C.UTF-8

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
RUNTIME_BASE="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
RUNTIME_DIR="${RUNTIME_BASE}/awtarchy-presentation-${UID}"
CONTROL_FIFO="${RUNTIME_DIR}/control"
PROFILE_FILE="${STATE_HOME}/awtarchy/presentation.tsv"
QUICKSHELL_STATE="${CACHE_HOME}/awtarchy/quickshell-state.json"

TITLE_LINE="Awtarchy Quickshell Update"
CONTROL_KEY="${AWTARCHY_PRESENTATION_KEY:-F10}"
NARRATION_MODE="${AWTARCHY_PRESENTATION_NARRATION:-robot}"
VOICE="${AWTARCHY_PRESENTATION_VOICE:-en-us+m3}"
VOICE_RATE="${AWTARCHY_PRESENTATION_RATE:-148}"
VOICE_PITCH="${AWTARCHY_PRESENTATION_PITCH:-34}"
VOICE_VOLUME="${AWTARCHY_PRESENTATION_VOLUME:-135}"
PACE="${AWTARCHY_PRESENTATION_PACE:-1.0}"
MOVE_FPS="${AWTARCHY_PRESENTATION_FPS:-36}"
DRY_RUN=0
MONITOR_OVERRIDE=""
START_SCENE="intro"
ONLY_SCENE=""

QUICKSHELL_MANAGER=""
APPLICATION_STATE=""
RUNTIME_RULES=""
TERMINAL_HELPER=""
NOTIFICATION_DEMO=""
TIPS_SCRIPT=""
SHADER_DIR=""

MONITOR=""
MON_X=0
MON_Y=0
MON_W=1920
MON_H=1080
POINT_X=0
POINT_Y=0
LAST_ADDRESS=""
LAST_MARKER=""
VOICE_PID=""
DEMO_PID=""
CONTROL_COMMAND=""
CONTROLS_INSTALLED=0
STATE_SNAPSHOTTED=0
CAPTURE_CHANGED=0
RESTORE_STARTED=0
ORIGINAL_CURSOR_X=""
ORIGINAL_CURSOR_Y=""
ORIGINAL_FOCUSED_MONITOR=""
ORIGINAL_WORKSPACE_ID=""
ORIGINAL_BAR_POS=""
ORIGINAL_SHADER=""
SHADER_SNAPSHOT_VALID=0
ORIGINAL_DND="false"
TEMP_WORKSPACE="name:awtarchy-presentation-${UID}-${BASHPID}"

declare -a OWNED_ADDRESSES=()
declare -a OWNED_MARKERS=()
declare -A ORIGINAL_CAPTURE=()

SCENE_IDS=(
    intro
    bar
    launcher
    quicksettings
    connectivity
    clipboard_notifications
    personalize
    windows
    shaders
    power
    outro
)

SCENE_LABELS=(
    "Opening title"
    "Adaptive Quickshell bar"
    "Application launcher"
    "Quick Settings control center"
    "Network, Bluetooth, and battery"
    "Clipboard and notifications"
    "Themes, wallpapers, and built-in help"
    "Hyprland windows and workspaces"
    "Post-processing shader reel"
    "Power menu"
    "Closing title"
)

if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_CYAN=$'\033[38;5;45m'
    C_BLUE=$'\033[38;5;75m'
    C_GREEN=$'\033[38;5;84m'
    C_YELLOW=$'\033[38;5;221m'
    C_RED=$'\033[38;5;203m'
else
    C_RESET="" C_BOLD="" C_DIM="" C_CYAN="" C_BLUE=""
    C_GREEN="" C_YELLOW="" C_RED=""
fi

warn() {
    printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}

die() {
    printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2
    exit 1
}

have() {
    command -v "$1" >/dev/null 2>&1
}

find_support_file() {
    local installed="$1" repository="$2"
    if [[ -x "$installed" ]]; then
        printf '%s\n' "$installed"
    elif [[ -x "$repository" ]]; then
        printf '%s\n' "$repository"
    else
        printf '%s\n' "$installed"
    fi
}

resolve_support_paths() {
    QUICKSHELL_MANAGER="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/quickshell.sh" \
        "$REPO_ROOT/config/hypr/scripts/quickshell.sh")"
    APPLICATION_STATE="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/quickshell_application_state.sh" \
        "$REPO_ROOT/config/hypr/scripts/quickshell_application_state.sh")"
    RUNTIME_RULES="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/quickshell_runtime_rules.sh" \
        "$REPO_ROOT/config/hypr/scripts/quickshell_runtime_rules.sh")"
    TERMINAL_HELPER="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/default_terminal.sh" \
        "$REPO_ROOT/config/hypr/scripts/default_terminal.sh")"
    NOTIFICATION_DEMO="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/quickshell_notification_layout_demo.sh" \
        "$REPO_ROOT/config/hypr/scripts/quickshell_notification_layout_demo.sh")"
    TIPS_SCRIPT="$(find_support_file \
        "$CONFIG_HOME/hypr/scripts/awtarchy-tips-tui.sh" \
        "$REPO_ROOT/config/hypr/scripts/awtarchy-tips-tui.sh")"

    if [[ -f "$CONFIG_HOME/hypr/shaders/subtle-crt" ]]; then
        SHADER_DIR="$CONFIG_HOME/hypr/shaders"
    else
        SHADER_DIR="$REPO_ROOT/config/hypr/shaders"
    fi
}

usage() {
    printf '%s\n' \
        "usage: tests/presentation [run] [options]" \
        "       tests/presentation setup [--monitor NAME]" \
        "       tests/presentation doctor [--silent]" \
        "       tests/presentation list-scenes" \
        "       tests/presentation self-test" \
        "" \
        "run options:" \
        "  --monitor NAME     Recorded display (saved by setup when omitted)" \
        "  --from SCENE       Begin at a named scene" \
        "  --scene SCENE      Present one scene for a clean retake" \
        "  --key KEY          Temporary control key (default: F10)" \
        "  --voice VOICE      espeak-ng voice (default: en-us+m3)" \
        "  --rate WPM         Voice rate (default: 148)" \
        "  --pace FACTOR      Visual pace; 0.5 is faster, 1.5 is slower" \
        "  --silent           Disable generated narration for a music-only cut" \
        "  --dry-run          Print the scene order without controlling the desktop" \
        "" \
        "temporary controls:" \
        "  SUPER+KEY             next scene" \
        "  SUPER+SHIFT+KEY       replay scene" \
        "  SUPER+CTRL+KEY        previous scene" \
        "  SUPER+ALT+KEY         stop and restore" \
        "" \
        "terminal fallback: Enter next, R replay, P previous, Q stop"
}

list_scenes() {
    local i
    for i in "${!SCENE_IDS[@]}"; do
        printf '%2d  %-26s %s\n' "$((i + 1))" "${SCENE_IDS[$i]}" "${SCENE_LABELS[$i]}"
    done
}

scene_index() {
    local wanted="$1" i
    for i in "${!SCENE_IDS[@]}"; do
        if [[ "${SCENE_IDS[$i]}" == "$wanted" ]]; then
            printf '%s\n' "$i"
            return 0
        fi
    done
    return 1
}

validate_number() {
    local value="$1" label="$2"
    [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "$label must be a positive number"
}

scaled_duration() {
    awk -v seconds="$1" -v pace="$PACE" 'BEGIN { printf "%.3f", seconds * pace }'
}

pause() {
    (( DRY_RUN == 1 )) && return 0
    sleep "$(scaled_duration "$1")"
}

lua_quote() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    printf '"%s"' "$value"
}

ipc() {
    (( DRY_RUN == 1 )) && return 0
    timeout 3 qs -c awtarchy ipc call "$@" >/dev/null 2>&1
}

ipc_value() {
    local value
    value="$(timeout 3 qs -c awtarchy ipc call "$@" 2>/dev/null | tail -n1 | tr -d '\r' || true)"
    value=${value#\"}
    value=${value%\"}
    printf '%s\n' "$value"
}

focus_recorded_monitor() {
    (( DRY_RUN == 1 )) && return 0
    hyprctl dispatch focusmonitor "$MONITOR" >/dev/null 2>&1 || true
}

close_surfaces() {
    local pair target action
    local -a pairs=(
        "launcher close"
        "quicksettings close"
        "network close"
        "bluetooth close"
        "battery close"
        "clipboard close"
        "notifications close"
        "themes close"
        "powermenu close"
        "notifications clearPopupPreview"
    )
    for pair in "${pairs[@]}"; do
        read -r target action <<<"$pair"
        ipc "$target" "$action" || true
    done
}

cursor_position() {
    local json
    json="$(hyprctl -j cursorpos 2>/dev/null || true)"
    if [[ -n "$json" ]] && jq -e '.x != null and .y != null' >/dev/null 2>&1 <<<"$json"; then
        jq -r '[(.x | round), (.y | round)] | @tsv' <<<"$json"
    else
        printf '%s\t%s\n' "$((MON_X + MON_W / 2))" "$((MON_Y + MON_H / 2))"
    fi
}

interpolate() {
    local start="$1" finish="$2" frame="$3" frames="$4"
    printf '%s\n' "$((start + (finish - start) * frame * frame * (3 * frames - 2 * frame) / (frames * frames * frames)))"
}

move_cursor_native() {
    local x="$1" y="$2"
    hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = ${x}, y = ${y} }))" >/dev/null 2>&1
}

smooth_move() {
    local target_x="$1" target_y="$2" duration="${3:-0.78}"
    local start_x start_y frames frame current_x current_y delay

    if (( DRY_RUN == 1 )); then
        printf 'mouse -> %s,%s (%ss)\n' "$target_x" "$target_y" "$duration"
        return 0
    fi

    IFS=$'\t' read -r start_x start_y < <(cursor_position)
    frames="$(awk -v seconds="$(scaled_duration "$duration")" -v fps="$MOVE_FPS" \
        'BEGIN { n = int(seconds * fps + 0.5); print n < 8 ? 8 : n }')"
    delay="$(awk -v fps="$MOVE_FPS" 'BEGIN { printf "%.4f", 1 / fps }')"

    for ((frame = 1; frame <= frames; frame++)); do
        current_x="$(interpolate "$start_x" "$target_x" "$frame" "$frames")"
        current_y="$(interpolate "$start_y" "$target_y" "$frame" "$frames")"
        move_cursor_native "$current_x" "$current_y" \
            || die "Hyprland rejected a presentation cursor move"
        sleep "$delay"
    done
}

left_click() {
    (( DRY_RUN == 1 )) && return 0
    ydotool click 0xC0 >/dev/null 2>&1 || die "ydotool click failed"
}

type_text() {
    (( DRY_RUN == 1 )) && return 0
    ydotool type --key-delay 42 "$1" >/dev/null 2>&1 || die "ydotool typing failed"
}

monitor_point() {
    local x_percent="$1" y_percent="$2"
    POINT_X=$((MON_X + MON_W * x_percent / 100))
    POINT_Y=$((MON_Y + MON_H * y_percent / 100))
}

current_bar_position() {
    local position
    position="$($QUICKSHELL_MANAGER getpos "$MONITOR" 2>/dev/null || true)"
    case "$position" in
        top|bottom|left|right) printf '%s\n' "$position" ;;
        *) printf '%s\n' "${ORIGINAL_BAR_POS:-top}" ;;
    esac
}

bar_point() {
    local role="$1" position="${2:-$(current_bar_position)}" percent=50 inset=14
    case "$role" in
        launcher) percent=2 ;;
        workspaces) percent=10 ;;
        center) percent=48 ;;
        stats) percent=69 ;;
        quicksettings) percent=77 ;;
        network) percent=86 ;;
        bluetooth) percent=89 ;;
        clipboard) percent=94 ;;
        notifications) percent=97 ;;
        power) percent=99 ;;
    esac

    case "$position" in
        top)
            POINT_X=$((MON_X + MON_W * percent / 100))
            POINT_Y=$((MON_Y + inset))
            ;;
        bottom)
            POINT_X=$((MON_X + MON_W * percent / 100))
            POINT_Y=$((MON_Y + MON_H - inset))
            ;;
        left)
            POINT_X=$((MON_X + inset))
            POINT_Y=$((MON_Y + MON_H * percent / 100))
            ;;
        right)
            POINT_X=$((MON_X + MON_W - inset))
            POINT_Y=$((MON_Y + MON_H * percent / 100))
            ;;
    esac
}

move_to_bar() {
    bar_point "$1" "${2:-$(current_bar_position)}"
    smooth_move "$POINT_X" "$POINT_Y" "${3:-0.78}"
}

client_json_by_title() {
    hyprctl clients -j 2>/dev/null \
        | jq -c --arg title "$1" '[.[] | select(.title == $title)] | last // empty' 2>/dev/null \
        || true
}

wait_for_title() {
    local title="$1" tries="${2:-60}" client
    while (( tries > 0 )); do
        client="$(client_json_by_title "$title")"
        if [[ -n "$client" ]]; then
            printf '%s\n' "$client"
            return 0
        fi
        sleep 0.05
        ((tries--))
    done
    return 1
}

window_point() {
    local title="$1" x_percent="$2" y_percent="$3" client x y width height
    client="$(client_json_by_title "$title")"
    [[ -n "$client" ]] || return 1
    read -r x y width height < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$client")
    POINT_X=$((x + width * x_percent / 100))
    POINT_Y=$((y + height * y_percent / 100))
}

hover_window() {
    local title="$1" x_percent="$2" y_percent="$3" duration="${4:-0.72}"
    window_point "$title" "$x_percent" "$y_percent" || return 1
    smooth_move "$POINT_X" "$POINT_Y" "$duration"
}

client_address_for_class() {
    hyprctl clients -j 2>/dev/null \
        | jq -r --arg class "$1" '
            [.[] | select(.class == $class or .initialClass == $class or .title == $class)]
            | last.address // empty
        ' 2>/dev/null || true
}

wait_for_class() {
    local class="$1" tries="${2:-80}" address
    while (( tries > 0 )); do
        address="$(client_address_for_class "$class")"
        if [[ -n "$address" ]]; then
            printf '%s\n' "$address"
            return 0
        fi
        sleep 0.05
        ((tries--))
    done
    return 1
}

position_owned_window() {
    local address="$1" requested_w="$2" requested_h="$3"
    local width height x y selector_lua monitor_lua
    width=$requested_w
    height=$requested_h
    (( width > MON_W - 40 )) && width=$((MON_W - 40))
    (( height > MON_H - 40 )) && height=$((MON_H - 40))
    x=$((MON_X + (MON_W - width) / 2))
    y=$((MON_Y + (MON_H - height) / 2))
    selector_lua="$(lua_quote "address:$address")"
    monitor_lua="$(lua_quote "$MONITOR")"

    hyprctl eval "
        hl.dispatch(hl.dsp.window.float({ action = \"enable\", window = ${selector_lua} }))
        hl.dispatch(hl.dsp.window.move({ monitor = ${monitor_lua}, follow = false, window = ${selector_lua} }))
        hl.dispatch(hl.dsp.window.resize({ x = ${width}, y = ${height}, relative = false, window = ${selector_lua} }))
        hl.dispatch(hl.dsp.window.move({ x = ${x}, y = ${y}, relative = false, window = ${selector_lua} }))
    " >/dev/null 2>&1 || true
}

launch_owned_terminal() {
    local class="$1" width="$2" height="$3"
    shift 3
    local address pid
    focus_recorded_monitor
    "$TERMINAL_HELPER" --class "$class" -- "$@" 7>&- 9>&- >/dev/null 2>&1 &
    pid=$!
    address="$(wait_for_class "$class" || true)"
    [[ -n "$address" ]] || {
        kill "$pid" 2>/dev/null || true
        warn "terminal window did not appear: $class"
        LAST_ADDRESS=""
        return 1
    }
    OWNED_ADDRESSES+=("$address")
    LAST_ADDRESS="$address"
    position_owned_window "$address" "$width" "$height"
    pause 0.45
}

launch_tiled_terminal() {
    local class="$1"
    shift
    local address pid
    "$TERMINAL_HELPER" --class "$class" -- "$@" 7>&- 9>&- >/dev/null 2>&1 &
    pid=$!
    address="$(wait_for_class "$class" || true)"
    [[ -n "$address" ]] || {
        kill "$pid" 2>/dev/null || true
        warn "tiled presentation window did not appear: $class"
        LAST_ADDRESS=""
        return 1
    }
    OWNED_ADDRESSES+=("$address")
    LAST_ADDRESS="$address"
    pause 0.35
}

close_owned_window() {
    local address="$1" marker="${2:-}" index
    [[ -z "$marker" ]] || rm -f -- "$marker"
    pause 0.35
    if [[ -n "$address" ]]; then
        hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
    fi
    for index in "${!OWNED_ADDRESSES[@]}"; do
        [[ "${OWNED_ADDRESSES[$index]}" == "$address" ]] && unset 'OWNED_ADDRESSES[index]'
    done
    for index in "${!OWNED_MARKERS[@]}"; do
        [[ "${OWNED_MARKERS[$index]}" == "$marker" ]] && unset 'OWNED_MARKERS[index]'
    done
    return 0
}

new_marker() {
    local name="$1" marker
    marker="$RUNTIME_DIR/${name}.keep"
    : >"$marker"
    OWNED_MARKERS+=("$marker")
    LAST_MARKER="$marker"
}

speak() {
    local text="$1"
    printf '%s%sVOICE%s  %s\n' "$C_BOLD" "$C_CYAN" "$C_RESET" "$text"
    [[ "$NARRATION_MODE" == robot ]] || return 0
    espeak-ng \
        -v "$VOICE" \
        -s "$VOICE_RATE" \
        -p "$VOICE_PITCH" \
        -a "$VOICE_VOLUME" \
        -g 3 \
        "$text" >/dev/null 2>&1
}

start_narration() {
    finish_narration
    speak "$1" &
    VOICE_PID=$!
}

finish_narration() {
    if [[ -n "$VOICE_PID" ]]; then
        wait "$VOICE_PID" 2>/dev/null || true
        VOICE_PID=""
    fi
}

show_flyout() {
    local target="$1" title="$2" role="$3"
    if [[ "$target" == network || "$target" == bluetooth || "$target" == battery ]]; then
        [[ "$(ipc_value "$target" available)" == true ]] || return 1
    fi

    move_to_bar "$role" "$(current_bar_position)" 0.62
    ipc "$target" open || return 1
    wait_for_title "$title" >/dev/null || {
        ipc "$target" close || true
        return 1
    }
    hover_window "$title" 50 18 0.68 || true
    pause 0.65
    hover_window "$title" 50 55 0.76 || true
    pause 0.85
    ipc "$target" close || true
    pause 0.35
}

set_bar_position() {
    local position="$1"
    "$QUICKSHELL_MANAGER" setpos "$MONITOR" "$position" >/dev/null 2>&1 || return 1
    ipc barstate refresh || true
    pause 0.9
}

set_shader() {
    local shader="$1" shader_lua
    shader_lua="$(lua_quote "$shader")"
    hyprctl eval "hl.config({ decoration = { screen_shader = ${shader_lua} } })" >/dev/null 2>&1
}

restore_shader() {
    (( SHADER_SNAPSHOT_VALID == 1 )) || return 0
    set_shader "$ORIGINAL_SHADER" || true
}

scene_intro() {
    local marker address
    new_marker intro
    marker="$LAST_MARKER"
    launch_owned_terminal awtarchy-presentation-intro 1260 520 \
        "$SCRIPT_PATH" __card intro "$marker" || true
    address="$LAST_ADDRESS"
    monitor_point 50 50
    smooth_move "$POINT_X" "$POINT_Y" 0.8
    start_narration "Awtarchy Quickshell Update. A focused Arch and Hyprland experience, built to look sharp, move smoothly, and stay completely yours."
    finish_narration
    pause 1.1
    close_owned_window "$address" "$marker"
}

scene_bar() {
    local alternate
    close_surfaces
    set_bar_position "$ORIGINAL_BAR_POS" || true
    focus_recorded_monitor
    start_narration "The new Quickshell bar keeps the essentials in reach, adapts to every display, and moves wherever your setup needs it."
    move_to_bar launcher "$ORIGINAL_BAR_POS" 0.8
    pause 0.45
    move_to_bar workspaces "$ORIGINAL_BAR_POS" 0.62
    pause 0.55
    move_to_bar center "$ORIGINAL_BAR_POS" 0.9
    pause 0.55
    move_to_bar stats "$ORIGINAL_BAR_POS" 0.72
    pause 0.55
    move_to_bar power "$ORIGINAL_BAR_POS" 1.0
    pause 0.8

    case "$ORIGINAL_BAR_POS" in
        top) alternate=left ;;
        bottom) alternate=right ;;
        left) alternate=top ;;
        right) alternate=bottom ;;
        *) alternate=left ;;
    esac
    if set_bar_position "$alternate"; then
        move_to_bar launcher "$alternate" 0.82
        pause 0.5
        move_to_bar power "$alternate" 1.15
        pause 0.8
        set_bar_position "$ORIGINAL_BAR_POS" || true
    fi
    finish_narration
}

scene_launcher() {
    local title="Awtarchy Application Search"
    close_surfaces
    focus_recorded_monitor
    start_narration "Launch what you need, the instant you need it. Search stays fast, clean, and out of the way."
    move_to_bar launcher "$(current_bar_position)" 0.8
    pause 0.35
    if ipc launcher open && wait_for_title "$title" >/dev/null; then
        if hover_window "$title" 50 7 0.65; then
            left_click
            type_text "terminal"
            pause 1.25
            hover_window "$title" 50 28 0.78 || true
            pause 0.7
            hover_window "$title" 50 62 0.82 || true
            pause 1.0
        fi
        ipc launcher close || true
    fi
    finish_narration
}

scene_quicksettings() {
    local title="Awtarchy Quick Settings"
    close_surfaces
    focus_recorded_monitor
    start_narration "Daily controls come together in one fluid panel, with the freedom to tune the desktop around you."
    move_to_bar quicksettings "$(current_bar_position)" 0.82
    pause 0.35
    if ipc quicksettings open && wait_for_title "$title" >/dev/null; then
        hover_window "$title" 50 16 0.72 || true
        pause 0.8
        hover_window "$title" 50 31 0.68 || true
        pause 0.75
        hover_window "$title" 50 53 0.76 || true
        pause 0.75
        if hover_window "$title" 96 3 0.7; then
            left_click
            pause 1.0
            hover_window "$title" 50 12 0.72 || true
            pause 0.85
            hover_window "$title" 35 24 0.68 || true
            pause 0.85
            hover_window "$title" 72 24 0.68 || true
            pause 0.8
        fi
        ipc quicksettings close || true
    fi
    finish_narration
}

scene_connectivity() {
    close_surfaces
    focus_recorded_monitor
    start_narration "Network, Bluetooth, and battery details feel like part of the desktop, not separate tools."
    show_flyout network "Awtarchy Network" network || true
    show_flyout bluetooth "Awtarchy Bluetooth" bluetooth || true
    show_flyout battery "Awtarchy Battery" quicksettings || true
    finish_narration
}

scene_clipboard_notifications() {
    local title demo_delay
    close_surfaces
    focus_recorded_monitor
    start_narration "Clipboard history and notifications stay close, searchable, and ready whenever your flow needs them."

    title="Awtarchy Clipboard History"
    move_to_bar clipboard "$(current_bar_position)" 0.7
    if ipc clipboard open && wait_for_title "$title" >/dev/null; then
        hover_window "$title" 50 8 0.62 || true
        pause 0.7
        hover_window "$title" 45 40 0.78 || true
        pause 0.9
        ipc clipboard close || true
    fi

    title="Awtarchy Notification Center"
    move_to_bar notifications "$(current_bar_position)" 0.72
    if ipc notifications open && wait_for_title "$title" >/dev/null; then
        hover_window "$title" 50 8 0.62 || true
        pause 0.7
        hover_window "$title" 50 40 0.74 || true
        pause 0.85
        ipc notifications close || true
    fi

    ipc notifications enable || true
    if [[ -x "$NOTIFICATION_DEMO" ]] && have notify-send; then
        demo_delay="$(scaled_duration 0.72)"
        AWTARCHY_NOTIFICATION_DEMO_DELAY="$demo_delay" "$NOTIFICATION_DEMO" >/dev/null 2>&1 &
        DEMO_PID=$!
        wait "$DEMO_PID" 2>/dev/null || true
        DEMO_PID=""
    else
        warn "notification layout demo is unavailable; continuing"
    fi
    [[ "$ORIGINAL_DND" == true ]] && ipc notifications disable || true
    finish_narration
}

scene_personalize() {
