scene_windows() {
    local marker_one marker_two marker_three address_one address_two address_three
    local client x y width height address
    close_surfaces
    focus_recorded_monitor
    hyprctl dispatch workspace "$TEMP_WORKSPACE" >/dev/null 2>&1 || true
    pause 0.6
    start_narration "Underneath, Hyprland keeps every window and workspace fast, animated, and effortlessly organized."

    new_marker demo-one
    marker_one="$LAST_MARKER"
    new_marker demo-two
    marker_two="$LAST_MARKER"
    new_marker demo-three
    marker_three="$LAST_MARKER"

    launch_tiled_terminal awtarchy-presentation-demo-one \
        "$SCRIPT_PATH" __demo "TERMINAL" "$marker_one" 45 || true
    address_one="$LAST_ADDRESS"
    launch_tiled_terminal awtarchy-presentation-demo-two \
        "$SCRIPT_PATH" __demo "CODE" "$marker_two" 75 || true
    address_two="$LAST_ADDRESS"
    launch_tiled_terminal awtarchy-presentation-demo-three \
        "$SCRIPT_PATH" __demo "SYSTEM" "$marker_three" 84 || true
    address_three="$LAST_ADDRESS"

    for address in "$address_one" "$address_two" "$address_three"; do
        [[ -n "$address" ]] || continue
        client="$(hyprctl clients -j 2>/dev/null | jq -c --arg address "$address" '.[] | select(.address == $address)' | head -n1)"
        [[ -n "$client" ]] || continue
        read -r x y width height < <(jq -r '[.at[0], .at[1], .size[0], .size[1]] | @tsv' <<<"$client")
        smooth_move "$((x + width / 2))" "$((y + height / 2))" 0.72
        pause 0.55
    done

    if [[ -n "$address_two" ]]; then
        position_owned_window "$address_two" "$((MON_W * 46 / 100))" "$((MON_H * 48 / 100))"
        pause 1.15
    fi

    hyprctl dispatch workspace "$ORIGINAL_WORKSPACE_ID" >/dev/null 2>&1 || true
    pause 0.85
    hyprctl dispatch workspace "$TEMP_WORKSPACE" >/dev/null 2>&1 || true
    pause 1.0

    close_owned_window "$address_one" "$marker_one"
    close_owned_window "$address_two" "$marker_two"
    close_owned_window "$address_three" "$marker_three"
    hyprctl dispatch workspace "$ORIGINAL_WORKSPACE_ID" >/dev/null 2>&1 || true
    finish_narration
}

scene_shaders() {
