    close_surfaces
    focus_recorded_monitor
    start_narration "Themes, wallpapers, built-in guidance, and practical system tools make Awtarchy easy to shape into your own."

    monitor_point 50 50
    smooth_move "$POINT_X" "$POINT_Y" 0.72
    if ipc themes open; then
